package views

import (
	"strings"

	"github.com/pflege-de-labs/teamster/internal/i18n"
	"github.com/pflege-de-labs/teamster/internal/models"
)

// Recipients is the page at /admin/recipients: every person who has linked a
// chat, and what stops being delivered if they are unlinked.
type Recipients struct {
	Viewer Viewer
	// CanEdit hides the unlink control from a viewer. Hiding is not enforcing
	// -- the server refuses the post either way.
	CanEdit bool
	Rows    []RecipientRow
	// Notice and Error report the outcome of the last unlink, the same way
	// Page's do -- this page posts to its own delete endpoint rather than
	// /admin, so it needs its own copy of that round trip.
	Notice string
	Error  string
}

// A RecipientRow pairs a recipient with the names of the routes that target
// them. An admin about to unlink somebody needs to see what stops being
// delivered before doing it, not after.
type RecipientRow struct {
	Recipient  models.Recipient
	RouteNames []string
}

// recipientName mirrors routing_api.go's recipientLabel: views cannot import
// httpserver, so the same fallback -- Name, then Subject, because Name comes
// from Teams and nothing guarantees it is set -- lives here too.
func recipientName(r models.Recipient) string {
	if r.Name != "" {
		return r.Name
	}
	return r.Subject
}

templ RecipientsPage(page Recipients) {
	@Layout(i18n.T(ctx, "page.recipients"), &page.Viewer) {
		@notice(page.Error, page.Notice)
		<section class="rounded-lg border border-slate-200 bg-white shadow-sm">
			<h2 class="border-b border-slate-200 px-6 py-4 text-lg font-semibold">
				{ i18n.T(ctx, "recipients.heading") }
			</h2>
			<div class="space-y-4 px-6 py-6">
				<p class="text-sm text-slate-600">{ i18n.T(ctx, "recipients.explainer") }</p>
				if len(page.Rows) == 0 {
					@empty(i18n.T(ctx, "recipients.empty"))
				} else {
					<ul class="divide-y divide-slate-200">
						for _, row := range page.Rows {
							@recipientItem(row, page.CanEdit)
						}
					</ul>
				}
			</div>
		</section>
	}
}

templ recipientItem(row RecipientRow, canEdit bool) {
	<li class="flex items-start justify-between gap-4 py-3">
		<div class="min-w-0 space-y-1">
			<div class="flex items-center gap-2">
				<span class="truncate font-medium">{ recipientName(row.Recipient) }</span>
				if row.Recipient.Blocked() {
					<span class="rounded bg-red-100 px-1.5 py-0.5 text-xs font-medium text-red-800">
						{ i18n.T(ctx, "recipients.blocked_badge") }
					</span>
				}
			</div>
			<div class="truncate text-xs text-slate-500">{ row.Recipient.Subject }</div>
			<div class="truncate text-xs text-slate-500">
				{ i18n.T(ctx, "recipients.linked_since", row.Recipient.CreatedAt.Format("2006-01-02 15:04")) }
			</div>
			if row.Recipient.Blocked() {
				<p class="rounded-md border border-red-300 bg-red-50 px-3 py-2 text-xs text-red-800">
					{ i18n.T(ctx, "recipients.blocked_detail", row.Recipient.BlockedReason, row.Recipient.BlockedAt.Format("2006-01-02 15:04")) }
				</p>
			}
			<div class="truncate text-xs text-slate-500">
				if len(row.RouteNames) == 0 {
					{ i18n.T(ctx, "recipients.no_routes") }
				} else {
					{ i18n.T(ctx, "recipients.routes", strings.Join(row.RouteNames, ", ")) }
				}
			</div>
		</div>
		<div class="flex shrink-0 items-center gap-2">
			if canEdit {
				@unlinkButton(row.Recipient.ID, recipientName(row.Recipient))
			}
		</div>
	</li>
}

// A form rather than a link, because unlinking must not be a GET -- the same
// reasoning deleteButton follows, with its own wording: "unlink" is what
// removing a recipient means, where "delete" is what the other panels do to a
// record an admin authored.
templ unlinkButton(id, name string) {
	<form method="post" action="/admin/recipients/delete">
		<input type="hidden" name="id" value={ id }/>
		<button
			type="submit"
			aria-label={ i18n.T(ctx, "action.unlink") + " " + name }
			class="rounded-md border border-slate-300 px-3 py-1.5 text-sm text-slate-700 hover:border-red-400 hover:bg-red-50 hover:text-red-700"
		>
			{ i18n.T(ctx, "action.unlink") }
		</button>
	</form>
}
