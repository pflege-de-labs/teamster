package views

import "github.com/pflege-de-labs/teamster/internal/i18n"

templ textField(name, label, placeholder, value string) {
	<label class="block">
		<span class="text-sm font-medium">{ label }</span>
		<input
			type="text"
			name={ name }
			value={ value }
			placeholder={ placeholder }
			class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-sky-500 focus:outline-none"
		/>
	</label>
}

templ identifiedTextField(id, name, label, placeholder, value string) {
	<label class="block">
		<span class="text-sm font-medium">{ label }</span>
		<input
			type="text"
			id={ id }
			name={ name }
			value={ value }
			placeholder={ placeholder }
			class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-sky-500 focus:outline-none"
		/>
	</label>
}

templ selectField(name, label string, options []option, selected string) {
	<label class="block">
		<span class="text-sm font-medium">{ label }</span>
		<select
			name={ name }
			class="mt-1 w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-sky-500 focus:outline-none"
		>
			if len(options) == 0 {
				<option value="">— none defined yet —</option>
			}
			for _, o := range options {
				if o.Value == selected {
					<option value={ o.Value } selected>{ o.Label }</option>
				} else {
					<option value={ o.Value }>{ o.Label }</option>
				}
			}
		</select>
	</label>
}

templ textareaField(name, label, value, rows string) {
	<label class="block">
		<span class="text-sm font-medium">{ label }</span>
		<textarea
			name={ name }
			rows={ rows }
			class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 font-mono text-xs shadow-sm focus:border-sky-500 focus:outline-none"
		>{ value }</textarea>
	</label>
}

templ checkboxField(name, label string, checked bool) {
	<label class="flex items-center gap-2">
		if checked {
			<input type="checkbox" name={ name } value="true" checked class="h-4 w-4 rounded border-slate-300"/>
		} else {
			<input type="checkbox" name={ name } value="true" class="h-4 w-4 rounded border-slate-300"/>
		}
		<span class="text-sm font-medium">{ label }</span>
	</label>
}

// The fragment lands the browser on the section whose form was just filled in.
templ editLink(section, id, name string) {
	<a
		href={ templ.SafeURL("/admin?edit=" + section + "&id=" + id + "#" + section) }
		aria-label={ i18n.T(ctx, "action.edit") + " " + name }
		class="rounded-md border border-slate-300 px-3 py-1.5 text-sm text-slate-700 hover:border-sky-400 hover:bg-sky-50 hover:text-sky-700"
	>
		{ i18n.T(ctx, "action.edit") }
	</a>
}

templ cancelEdit() {
	<a href="/admin" class="px-3 py-2 text-sm text-slate-600 underline hover:text-slate-900">{ i18n.T(ctx, "action.cancel") }</a>
}

templ submit(label string) {
	<button
		type="submit"
		class="rounded-md bg-sky-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-sky-700 focus:outline-none focus:ring-2 focus:ring-sky-500"
	>
		{ label }
	</button>
}

// A form rather than a link, because deleting must not be a GET.
templ deleteButton(action, id, name string) {
	<form method="post" action={ templ.SafeURL(action) }>
		<input type="hidden" name="id" value={ id }/>
		<button
			type="submit"
			aria-label={ i18n.T(ctx, "action.delete") + " " + name }
			class="rounded-md border border-slate-300 px-3 py-1.5 text-sm text-slate-700 hover:border-red-400 hover:bg-red-50 hover:text-red-700"
		>
			{ i18n.T(ctx, "action.delete") }
		</button>
	</form>
}

templ empty(message string) {
	<p class="rounded-md border border-dashed border-slate-300 px-4 py-6 text-center text-sm text-slate-500">
		{ message }
	</p>
}

// pickerField is a text field the browser may replace with a select once
// Microsoft Graph answers. The words that select needs travel with the field,
// because the script that builds it has no catalog and no language.
templ pickerField(id, name, label, placeholder, value, pickerLabel, pickerPlaceholder, requiresTeam string) {
	<label class="block">
		<span class="text-sm font-medium">{ label }</span>
		<input
			type="text"
			id={ id }
			name={ name }
			value={ value }
			placeholder={ placeholder }
			data-picker-label={ pickerLabel }
			data-picker-placeholder={ pickerPlaceholder }
			data-picker-requires-team={ requiresTeam }
			class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-sky-500 focus:outline-none"
		/>
	</label>
}
