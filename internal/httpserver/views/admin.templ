package views

import (
	"slices"
	"strconv"
	"github.com/pflege-de-labs/teamster/internal/i18n"
)

templ Admin(page Page) {
	@Layout(i18n.T(ctx, "page.admin"), &page.Viewer) {
		@notice(page.Error, page.Notice)
		@readOnlyNotice(page)
		@templates(page)
		@destinations(page)
		@webhooks(page)
		@routes(page)
		@grants(page)
	}
}

templ templates(page Page) {
	@panel(i18n.T(ctx, "templates.panel"), "templates") {
		if page.CanEdit {
			// Preview beside the editor keeps a change and its effect in view together.
			<form method="post" action="/admin/templates" id="template-form" class="grid gap-6 lg:col-span-2 lg:grid-cols-2">
				<div class="min-w-0 space-y-3">
					if page.EditTemplate != nil {
						<input type="hidden" name="id" value={ page.EditTemplate.ID }/>
					}
					@textField("name", i18n.T(ctx, "templates.name"), i18n.T(ctx, "templates.name_placeholder"), page.editingTemplate().Name)
					<fieldset>
						<legend class="text-sm font-medium">{ i18n.T(ctx, "templates.sources") }</legend>
						<div class="mt-1 flex flex-wrap gap-4">
							for _, o := range sourceOptions(ctx) {
								<label class="flex items-center gap-2 text-sm">
									<input type="checkbox" name="sources" value={ o.Value } checked?={ slices.Contains(page.editingTemplate().Sources, o.Value) } class="h-4 w-4 rounded border-slate-300"/>
									{ o.Label }
								</label>
							}
						</div>
						<p class="mt-1 text-xs text-slate-500">{ i18n.T(ctx, "templates.sources_hint") }</p>
					</fieldset>
					@editorLine("title", i18n.T(ctx, "templates.title_field"), "{{ .Alert.Annotations.summary }}", page.editingTemplate().Title, "template-line")
					@editorField("message_text", i18n.T(ctx, "templates.text_field"), page.editingTemplate().Text, "4", "template")
					@cardPalette(page)
					@editorField("body", i18n.T(ctx, "templates.body_field"), page.editingTemplate().Body, "12", "card")
					@templ.JSONScript("template-vocabulary", page.Vocabulary)
					<div class="flex flex-wrap items-center gap-2">
						@submit(submitLabel(ctx, page.EditTemplate != nil, "noun.template"))
						if page.EditTemplate != nil {
							@cancelEdit()
						}
					</div>
				</div>
				<div class="min-w-0 space-y-3 lg:sticky lg:top-4 lg:self-start">
					<div class="flex flex-wrap items-center gap-2">
						<button
							type="button"
							id="preview-button"
							class="rounded-md border border-slate-300 px-3 py-1.5 text-sm font-medium text-slate-700 hover:border-sky-400 hover:bg-sky-50 hover:text-sky-700"
						>
							{ i18n.T(ctx, "preview.button") }
						</button>
						<label class="inline-flex items-center gap-1.5 text-sm text-slate-600">
							<input type="checkbox" id="preview-live" checked class="rounded border-slate-300"/>
							{ i18n.T(ctx, "preview.live") }
						</label>
						<select
							id="preview-sample"
							aria-label={ i18n.T(ctx, "templates.sample_alert") }
							class="rounded-md border border-slate-300 bg-white px-2 py-1.5 text-sm"
						>
							for _, name := range page.PreviewSamples {
								<option value={ name }>{ i18n.T(ctx, "sample."+name) }</option>
							}
						</select>
					</div>
					<div id="preview-output" class="peer space-y-3 empty:hidden"></div>
					<p class="hidden rounded-md border border-dashed border-slate-300 px-4 py-6 text-center text-sm text-slate-500 peer-empty:block">
						{ i18n.T(ctx, "preview.empty") }
					</p>
				</div>
			</form>
		}
		<div class="lg:col-span-2">
			if len(page.Templates) == 0 {
				@empty(i18n.T(ctx, "templates.empty"))
			} else {
				<ul class="divide-y divide-slate-200">
					for _, t := range page.Templates {
						<li class="flex items-center justify-between gap-4 py-3">
							<div class="min-w-0">
								<div class="truncate font-medium">{ t.Name }</div>
								<div class="truncate text-xs text-slate-500">
									{ templateShape(ctx, t) } · { sourcesText(ctx, t) } · { i18n.T(ctx, "templates.updated", t.UpdatedAt.Format("2006-01-02 15:04")) }
								</div>
							</div>
							<div class="flex shrink-0 items-center gap-2">
								if page.CanEdit {
									@editLink("templates", t.ID, t.Name)
									@deleteButton("/admin/templates/delete", t.ID, t.Name)
								}
							</div>
						</li>
					}
				</ul>
			}
		</div>
	}
}

templ destinations(page Page) {
	@panel(i18n.T(ctx, "destinations.panel"), "destinations") {
		if page.CanEdit {
			<form method="post" action="/admin/destinations" class="space-y-3">
				if page.EditDestination != nil {
					<input type="hidden" name="id" value={ page.EditDestination.ID }/>
				}
				@textField("name", i18n.T(ctx, "templates.name"), i18n.T(ctx, "destinations.name_placeholder"), page.editingDestination().Name)
				@pickerField("destination-team", "team_id", i18n.T(ctx, "destinations.team"), "team-id", page.editingDestination().TeamID, i18n.T(ctx, "picker.team"), i18n.T(ctx, "picker.team_choose"), "", page.BrokerAvailable, i18n.T(ctx, "picker.all_teams"), i18n.T(ctx, "picker.my_teams"))
				@pickerField("destination-channel", "channel_id", i18n.T(ctx, "destinations.channel"), "channel-id", page.editingDestination().ChannelID, i18n.T(ctx, "picker.channel"), i18n.T(ctx, "picker.channel_choose"), i18n.T(ctx, "picker.channel_needs_team"), false, "", "")
				<p id="destination-channel-hint" hidden class="text-xs text-slate-500">{ i18n.T(ctx, "picker.channel_needs_team") }</p>
				<p
					id="destination-install-hint"
					hidden
					class="rounded-md border border-amber-300 bg-amber-50 px-3 py-2 text-xs text-amber-900"
					data-group-installed={ i18n.T(ctx, "install.group_installed") }
					data-group-missing={ i18n.T(ctx, "install.group_missing") }
					data-group-unknown={ i18n.T(ctx, "install.group_unknown") }
					data-text-missing={ i18n.T(ctx, "install.hint_missing") }
					data-text-unknown={ i18n.T(ctx, "install.hint_unknown") }
				>
					<span data-install-text></span>
					<a href="/admin/teams" class="underline">{ i18n.T(ctx, "install.hint_link") }</a>
				</p>
				<div class="flex items-center gap-2">
					@submit(submitLabel(ctx, page.EditDestination != nil, "noun.destination"))
					if page.EditDestination != nil {
						@cancelEdit()
					}
				</div>
			</form>
		}
		<div>
			if len(page.Destinations) == 0 {
				@empty(i18n.T(ctx, "destinations.empty"))
			} else {
				<ul class="divide-y divide-slate-200">
					for _, d := range page.Destinations {
						<li class="flex items-center justify-between gap-4 py-3">
							<div class="min-w-0">
								<div class="flex items-center gap-2">
									<span class="truncate font-medium">{ d.Name }</span>
									if d.IsDefault {
										<span class="rounded bg-sky-100 px-1.5 py-0.5 text-xs font-medium text-sky-800">{ i18n.T(ctx, "destinations.badge_global_default") }</span>
									}
									if page.InstallStates[d.TeamID] == "missing" {
										<a href="/admin/teams" class="rounded bg-amber-100 px-1.5 py-0.5 text-xs font-medium text-amber-900">{ i18n.T(ctx, "destinations.badge_app_missing") }</a>
									}
								</div>
								<div class="truncate text-xs text-slate-500">team { d.TeamID } · channel { d.ChannelID }</div>
							</div>
							<div class="flex shrink-0 items-center gap-2">
								if page.CanManage && !d.IsDefault {
									@makeDefaultButton(d.ID, d.Name)
								}
								if page.CanEdit {
									@editLink("destinations", d.ID, d.Name)
									@deleteButton("/admin/destinations/delete", d.ID, d.Name)
								}
							</div>
						</li>
					}
				</ul>
			}
		</div>
	}
}

// Switching the global default is its own form, like rotating a webhook token,
// because it changes where every unclaimed message goes.
templ makeDefaultButton(id, name string) {
	<form method="post" action="/admin/destinations/default">
		<input type="hidden" name="id" value={ id }/>
		<button
			type="submit"
			aria-label={ i18n.T(ctx, "destinations.make_default") + " " + name }
			class="rounded-md border border-slate-300 px-3 py-1.5 text-sm text-slate-700 hover:border-sky-400 hover:bg-sky-50 hover:text-sky-700"
		>
			{ i18n.T(ctx, "destinations.make_default") }
		</button>
	</form>
}

templ webhooks(page Page) {
	@panel(i18n.T(ctx, "webhooks.panel"), "webhooks") {
		if page.CanEdit {
			<form method="post" action="/admin/webhooks" class="space-y-3">
				if page.EditWebhookEndpoint != nil {
					<input type="hidden" name="id" value={ page.EditWebhookEndpoint.ID }/>
				}
				@textField("team_slug", i18n.T(ctx, "webhooks.team_slug"), "platform", page.editingWebhookEndpoint().TeamSlug)
				@textField("channel_slug", i18n.T(ctx, "webhooks.channel_slug"), "alerts", page.editingWebhookEndpoint().ChannelSlug)
				@selectField("destination_id", i18n.T(ctx, "routes.destination"), destinationOptions(page), page.editingWebhookEndpoint().DestinationID)
				@selectField("template_id", i18n.T(ctx, "webhooks.template"), webhookTemplateOptions(ctx, page), page.editingWebhookEndpoint().TemplateID)
				<p class="text-xs text-slate-500">{ i18n.T(ctx, "webhooks.hint") }</p>
				<div class="flex items-center gap-2">
					@submit(submitLabel(ctx, page.EditWebhookEndpoint != nil, "noun.webhook"))
					if page.EditWebhookEndpoint != nil {
						@cancelEdit()
					}
				</div>
			</form>
		}
		<div>
			if page.NewWebhookURL != "" {
				@revealedWebhookURL(page.NewWebhookURL)
			}
			if len(page.WebhookEndpoints) == 0 {
				@empty(i18n.T(ctx, "webhooks.empty"))
			} else {
				<ul class="divide-y divide-slate-200">
					for _, e := range page.WebhookEndpoints {
						<li class="flex items-center justify-between gap-4 py-3">
							<div class="min-w-0">
								<div class="truncate font-medium">/teamsv2/{ e.TeamSlug }/{ e.ChannelSlug }</div>
								<div class="truncate text-xs text-slate-500">
									{ page.destinationName(e.DestinationID) }
									if e.TemplateID != "" {
										· { page.templateName(e.TemplateID) }
									}
								</div>
							</div>
							<div class="flex shrink-0 items-center gap-2">
								if page.CanEdit {
									@rotateButton(e.ID, e.TeamSlug+"/"+e.ChannelSlug)
									@editLink("webhooks", e.ID, e.TeamSlug+"/"+e.ChannelSlug)
									@deleteButton("/admin/webhooks/delete", e.ID, e.TeamSlug+"/"+e.ChannelSlug)
								}
							</div>
						</li>
					}
				</ul>
			}
		</div>
	}
}

// The URL is shown once, in the answer to the post that generated it. Only a
// digest is stored, so there is no second chance to read it.
templ revealedWebhookURL(url string) {
	<div class="mb-4 rounded-md border border-amber-300 bg-amber-50 px-4 py-3">
		<p class="text-sm font-medium text-amber-900">{ i18n.T(ctx, "webhooks.new_url") }</p>
		<code class="mt-1 block break-all text-xs text-amber-900">{ url }</code>
	</div>
}

// Rotating is its own form, so that saving an endpoint cannot change the secret
// a sender is already using by accident.
templ rotateButton(id, name string) {
	<form method="post" action="/admin/webhooks/rotate">
		<input type="hidden" name="id" value={ id }/>
		<button
			type="submit"
			aria-label={ i18n.T(ctx, "webhooks.rotate") + " " + name }
			class="rounded-md border border-slate-300 px-3 py-1.5 text-sm text-slate-700 hover:border-amber-400 hover:bg-amber-50 hover:text-amber-700"
		>
			{ i18n.T(ctx, "webhooks.rotate") }
		</button>
	</form>
}

templ routes(page Page) {
	@panel(i18n.T(ctx, "routes.panel"), "routes") {
		if page.CanEdit {
			<form method="post" action="/admin/routes" class="space-y-3">
				if page.EditRoute != nil {
					<input type="hidden" name="id" value={ page.EditRoute.ID }/>
				}
				@textField("name", i18n.T(ctx, "templates.name"), i18n.T(ctx, "routes.name_placeholder"), page.editingRoute().Name)
				@selectField("parent_id", i18n.T(ctx, "routes.parent"), parentOptions(ctx, page), page.editingRoute().ParentID)
				@editorField("label_selector", i18n.T(ctx, "routes.selector"), selectorJSON(page), "3", "selector")
				@selectField("target", i18n.T(ctx, "routes.target"), routeTargetOptions(ctx, page), routeTargetValue(page.editingRoute()))
				<p class="text-xs text-slate-500">{ i18n.T(ctx, "routes.target_hint") }</p>
				@selectField("template_id", i18n.T(ctx, "routes.template"), routeTemplateOptions(ctx, page), page.editingRoute().TemplateID)
				<label class="block">
					<span class="text-sm font-medium">{ i18n.T(ctx, "routes.priority") }</span>
					<input
						type="number"
						name="priority"
						value={ strconv.Itoa(page.editingRoute().Priority) }
						class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-sky-500 focus:outline-none"
					/>
				</label>
				@checkboxField("is_default", i18n.T(ctx, "routes.default"), page.editingRoute().IsDefault)
				@checkboxField("greedy", i18n.T(ctx, "routes.greedy"), page.editingRoute().Greedy)
				<div class="flex items-center gap-2">
					@submit(submitLabel(ctx, page.EditRoute != nil, "noun.route"))
					if page.EditRoute != nil {
						@cancelEdit()
					}
				</div>
			</form>
		}
		<div>
			if len(page.Routes) == 0 {
				@empty(i18n.T(ctx, "routes.empty"))
			}
			if len(page.Routes) > 0 || page.GlobalDefault != nil {
				<ul class="divide-y divide-slate-200">
					for _, r := range page.routeTree() {
						<li class={ "flex items-start justify-between gap-4 py-3", indent(r.Depth) }>
							<div class="min-w-0 space-y-1">
								<div class="flex items-center gap-2">
									<span class="truncate font-medium">{ r.Route.Name }</span>
									if r.Route.IsDefault {
										<span class="rounded bg-sky-100 px-1.5 py-0.5 text-xs font-medium text-sky-800">{ i18n.T(ctx, "routes.badge_default") }</span>
									}
									if r.Depth > 0 && r.Route.Greedy {
										<span class="rounded bg-amber-100 px-1.5 py-0.5 text-xs font-medium text-amber-800">{ i18n.T(ctx, "routes.badge_instead") }</span>
									}
									if r.Depth > 0 && !r.Route.Greedy {
										<span class="rounded bg-emerald-100 px-1.5 py-0.5 text-xs font-medium text-emerald-800">{ i18n.T(ctx, "routes.badge_as_well") }</span>
									}
									<span class="text-xs text-slate-500">{ i18n.T(ctx, "routes.priority_badge", r.Route.Priority) }</span>
									if r.Route.DestinationID != "" && r.Route.RecipientID != "" {
										<span class="rounded bg-rose-100 px-1.5 py-0.5 text-xs font-medium text-rose-800">{ i18n.T(ctx, "routes.badge_both") }</span>
									}
								</div>
								<div class="truncate text-xs text-slate-500">
									@inheritable(page.destinationName(r.Destination.ID), r.Destination.Inherited)
									<span>·</span>
									@inheritable(page.templateName(r.Template.ID), r.Template.Inherited)
								</div>
								<div class="truncate font-mono text-xs text-slate-500">{ selectorText(ctx, r.Route.LabelSelector) }</div>
							</div>
							<div class="flex shrink-0 items-center gap-2">
								if page.CanEdit {
									@editLink("routes", r.Route.ID, r.Route.Name)
									@deleteButton("/admin/routes/delete", r.Route.ID, r.Route.Name)
								}
							</div>
						</li>
					}
					if page.GlobalDefault != nil {
						@globalDefaultRoute(page)
					}
				</ul>
			}
		</div>
	}
}

// The global default is drawn as the last route because that is where it is
// evaluated. It is not stored, so it has nothing to edit or delete.
templ globalDefaultRoute(page Page) {
	<li class="flex items-start justify-between gap-4 py-3" data-synthetic-route="global-default">
		<div class="min-w-0 space-y-1">
			<div class="flex items-center gap-2">
				<span class="truncate font-medium italic">{ i18n.T(ctx, "routes.global_default") }</span>
				<span class="rounded bg-slate-100 px-1.5 py-0.5 text-xs font-medium text-slate-700">{ i18n.T(ctx, "routes.badge_synthetic") }</span>
			</div>
			<div class="truncate text-xs text-slate-500">
				{ page.destinationName(page.GlobalDefault.ID) }
				<span>·</span>
				if page.GlobalDefaultTemplateID == "" {
					<span class="italic">{ i18n.T(ctx, "routes.global_default_builtin") }</span>
				} else {
					<span>{ page.templateName(page.GlobalDefaultTemplateID) }</span>
				}
			</div>
			<div class="text-xs text-slate-500">{ i18n.T(ctx, "routes.global_default_hint") }</div>
			if page.CanEdit {
				<form method="post" action="/admin/routes/global-default" class="flex items-end gap-2 pt-1">
					@selectField("template_id", i18n.T(ctx, "routes.global_default_template"), globalDefaultTemplateOptions(ctx, page), page.GlobalDefaultTemplateID)
					@submit(i18n.T(ctx, "routes.global_default_save"))
				</form>
			}
		</div>
	</li>
}

// An inherited destination or template is shown in a lighter style, so what a
// route sets and what it takes from its parent are told apart at a glance.
templ inheritable(name string, inherited bool) {
	if inherited {
		<span class="italic text-slate-400">{ i18n.T(ctx, "routes.inherited", name) }</span>
	} else {
		<span>{ name }</span>
	}
}

// Without this, a viewer sees a page with no buttons and no reason given.
templ readOnlyNotice(page Page) {
	if !page.CanEdit {
		<p class="mb-4 rounded-md border border-slate-300 bg-slate-50 px-4 py-3 text-sm text-slate-700">
			{ i18n.T(ctx, "admin.read_only", page.Viewer.roleLabel(ctx)) }
		</p>
	}
}

// The grants panel moved to its own page: the tree of Teams and channels is as
// long as the tenant is, and /admin was already long. What is left here is the
// way to it.
templ grants(page Page) {
	if page.CanManage {
		@panel(i18n.T(ctx, "grants.panel"), "grants") {
			<p class="text-sm text-slate-600">{ i18n.T(ctx, "grants.moved") }</p>
			<a
				href="/admin/permissions"
				class="mt-3 inline-block rounded-md border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:border-sky-400 hover:bg-sky-50 hover:text-sky-700"
			>
				{ i18n.T(ctx, "nav.permissions") }
			</a>
		}
	}
}

// The palette inserts card elements at the cursor. The fragments come from Go,
// where a test renders every one of them, rather than being typed into the page
// where nothing would check them.
templ cardPalette(page Page) {
	<div class="flex flex-wrap items-center gap-2">
		<span class="text-sm font-medium text-slate-700">{ i18n.T(ctx, "palette.insert") }</span>
		for _, snippet := range page.Snippets {
			<button
				type="button"
				class="snippet rounded-md border border-slate-300 px-2 py-1 text-xs text-slate-700 hover:border-sky-400 hover:bg-sky-50 hover:text-sky-700"
				title={ i18n.T(ctx, snippet.HelpKey) }
				data-snippet={ snippet.Body }
			>
				{ i18n.T(ctx, snippet.LabelKey) }
			</button>
		}
		<button
			type="button"
			id="card-starter"
			class="rounded-md border border-slate-300 px-2 py-1 text-xs text-slate-700 hover:border-sky-400 hover:bg-sky-50 hover:text-sky-700"
			title={ i18n.T(ctx, "palette.starter_help") }
			data-snippet={ page.Starter }
		>
			{ i18n.T(ctx, "palette.starter") }
		</button>
	</div>
}
