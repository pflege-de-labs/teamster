package views

import "strconv"

templ Admin(page Page) {
	@Layout("Teamster Admin", &page.Viewer) {
		@notice(page)
		@readOnlyNotice(page)
		@templates(page)
		@destinations(page)
		@routes(page)
		@grants(page)
	}
}

templ templates(page Page) {
	@panel("Templates", "templates") {
		if page.CanEdit {
			<form method="post" action="/admin/templates" id="template-form" class="space-y-3">
				if page.EditTemplate != nil {
					<input type="hidden" name="id" value={ page.EditTemplate.ID }/>
				}
				@textField("name", "Name", "Critical alert", page.editingTemplate().Name)
				@textField("title", "Activity feed title", "{{ .Alert.Annotations.summary }}", page.editingTemplate().Title)
				@textareaField("message_text", "Message text (optional, limited HTML)", page.editingTemplate().Text, "4")
				@textareaField("body", "Adaptive Card JSON (optional)", page.editingTemplate().Body, "12")
				<div class="flex flex-wrap items-center gap-2">
					@submit(submitLabel(page.EditTemplate != nil, "template"))
					<button
						type="button"
						id="preview-button"
						class="rounded-md border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:border-sky-400 hover:bg-sky-50 hover:text-sky-700"
					>
						Preview
					</button>
					<select
						id="preview-sample"
						aria-label="Sample alert"
						class="rounded-md border border-slate-300 bg-white px-2 py-2 text-sm"
					>
						for _, name := range page.PreviewSamples {
							<option value={ name }>{ name } alert</option>
						}
					</select>
					if page.EditTemplate != nil {
						@cancelEdit()
					}
				</div>
				<div id="preview-output" class="mt-2 empty:hidden"></div>
			</form>
		}
		<div>
			if len(page.Templates) == 0 {
				@empty("No templates yet. A route needs one to render its message.")
			} else {
				<ul class="divide-y divide-slate-200">
					for _, t := range page.Templates {
						<li class="flex items-center justify-between gap-4 py-3">
							<div class="min-w-0">
								<div class="truncate font-medium">{ t.Name }</div>
								<div class="truncate text-xs text-slate-500">
									{ templateShape(t) } · updated { t.UpdatedAt.Format("2006-01-02 15:04") }
								</div>
							</div>
							<div class="flex shrink-0 items-center gap-2">
								if page.CanEdit {
									@editLink("templates", t.ID, t.Name)
									@deleteButton("/admin/templates/delete", t.ID, t.Name)
								}
							</div>
						</li>
					}
				</ul>
			}
		</div>
	}
}

templ destinations(page Page) {
	@panel("Destinations", "destinations") {
		if page.CanEdit {
			<form method="post" action="/admin/destinations" class="space-y-3">
				if page.EditDestination != nil {
					<input type="hidden" name="id" value={ page.EditDestination.ID }/>
				}
				@textField("name", "Name", "Ops channel", page.editingDestination().Name)
				@identifiedTextField("destination-team", "team_id", "Team", "team-id", page.editingDestination().TeamID)
				@identifiedTextField("destination-channel", "channel_id", "Channel", "channel-id", page.editingDestination().ChannelID)
				<div class="flex items-center gap-2">
					@submit(submitLabel(page.EditDestination != nil, "destination"))
					if page.EditDestination != nil {
						@cancelEdit()
					}
				</div>
			</form>
		}
		<div>
			if len(page.Destinations) == 0 {
				@empty("No destinations yet. Add the Team and channel to post into.")
			} else {
				<ul class="divide-y divide-slate-200">
					for _, d := range page.Destinations {
						<li class="flex items-center justify-between gap-4 py-3">
							<div class="min-w-0">
								<div class="truncate font-medium">{ d.Name }</div>
								<div class="truncate text-xs text-slate-500">team { d.TeamID } · channel { d.ChannelID }</div>
							</div>
							<div class="flex shrink-0 items-center gap-2">
								if page.CanEdit {
									@editLink("destinations", d.ID, d.Name)
									@deleteButton("/admin/destinations/delete", d.ID, d.Name)
								}
							</div>
						</li>
					}
				</ul>
			}
		</div>
	}
}

templ routes(page Page) {
	@panel("Routes", "routes") {
		if page.CanEdit {
			<form method="post" action="/admin/routes" class="space-y-3">
				if page.EditRoute != nil {
					<input type="hidden" name="id" value={ page.EditRoute.ID }/>
				}
				@textField("name", "Name", "Critical to ops", page.editingRoute().Name)
				@selectField("parent_id", "Refines (optional)", parentOptions(page), page.editingRoute().ParentID)
				@textareaField("label_selector", "Label selector (JSON)", selectorJSON(page), "3")
				@selectField("destination_id", "Destination", destinationOptions(page), page.editingRoute().DestinationID)
				@selectField("template_id", "Template", templateOptions(page), page.editingRoute().TemplateID)
				<label class="block">
					<span class="text-sm font-medium">Priority</span>
					<input
						type="number"
						name="priority"
						value={ strconv.Itoa(page.editingRoute().Priority) }
						class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-sky-500 focus:outline-none"
					/>
				</label>
				@checkboxField("is_default", "Default route", page.editingRoute().IsDefault)
				@checkboxField("greedy", "Deliver instead of the route it refines, not as well as it", page.editingRoute().Greedy)
				<div class="flex items-center gap-2">
					@submit(submitLabel(page.EditRoute != nil, "route"))
					if page.EditRoute != nil {
						@cancelEdit()
					}
				</div>
			</form>
		}
		<div>
			if len(page.Routes) == 0 {
				@empty("No routes yet. Without one, every alert is rejected.")
			} else {
				<ul class="divide-y divide-slate-200">
					for _, r := range page.routeTree() {
						<li class={ "flex items-start justify-between gap-4 py-3", indent(r.Depth) }>
							<div class="min-w-0 space-y-1">
								<div class="flex items-center gap-2">
									<span class="truncate font-medium">{ r.Route.Name }</span>
									if r.Route.IsDefault {
										<span class="rounded bg-sky-100 px-1.5 py-0.5 text-xs font-medium text-sky-800">default</span>
									}
									if r.Depth > 0 && r.Route.Greedy {
										<span class="rounded bg-amber-100 px-1.5 py-0.5 text-xs font-medium text-amber-800">instead of parent</span>
									}
									if r.Depth > 0 && !r.Route.Greedy {
										<span class="rounded bg-emerald-100 px-1.5 py-0.5 text-xs font-medium text-emerald-800">as well as parent</span>
									}
									<span class="text-xs text-slate-500">priority { strconv.Itoa(r.Route.Priority) }</span>
								</div>
								<div class="truncate text-xs text-slate-500">
									@inheritable(page.destinationName(r.Destination.ID), r.Destination.Inherited)
									<span>·</span>
									@inheritable(page.templateName(r.Template.ID), r.Template.Inherited)
								</div>
								<div class="truncate font-mono text-xs text-slate-500">{ selectorText(r.Route.LabelSelector) }</div>
							</div>
							<div class="flex shrink-0 items-center gap-2">
								if page.CanEdit {
									@editLink("routes", r.Route.ID, r.Route.Name)
									@deleteButton("/admin/routes/delete", r.Route.ID, r.Route.Name)
								}
							</div>
						</li>
					}
				</ul>
			}
		</div>
	}
}

// An inherited destination or template is shown in a lighter style, so what a
// route sets and what it takes from its parent are told apart at a glance.
templ inheritable(name string, inherited bool) {
	if inherited {
		<span class="italic text-slate-400">{ name } (inherited)</span>
	} else {
		<span>{ name }</span>
	}
}

// Without this, a viewer sees a page with no buttons and no reason given.
templ readOnlyNotice(page Page) {
	if !page.CanEdit {
		<p class="mb-4 rounded-md border border-slate-300 bg-slate-50 px-4 py-3 text-sm text-slate-700">
			Signed in with the { page.Viewer.roleLabel() } role, which may look but not change anything.
		</p>
	}
}

// Grants are the admin's alone: they decide who may deliver where, which is not
// something an editor should be able to widen for themselves.
templ grants(page Page) {
	if page.CanManage {
		@panel("Delivery permissions", "grants") {
			<p class="mb-4 text-sm text-slate-600">
				A role with no grant reaches every Team and channel. Once a grant names a role, that role
				reaches what its grants name and nothing else. Admins are never limited.
			</p>
			<form method="post" action="/admin/grants" class="space-y-3">
				@textField("role", "Role", "editor", "")
				@textField("team_id", "Team ID", "19:abc...@thread.tacv2", "")
				@textField("channel_id", "Channel ID (optional, empty grants the whole Team)", "19:def...@thread.tacv2", "")
				@submit("Add grant")
			</form>
			<div>
				if len(page.Grants) == 0 {
					@empty("No grants yet, so every role reaches every Team and channel.")
				} else {
					<ul class="divide-y divide-slate-200">
						for _, g := range page.Grants {
							<li class="flex items-center justify-between gap-4 py-3">
								<div class="min-w-0">
									<div class="truncate font-medium">{ g.Role }</div>
									<div class="truncate font-mono text-xs text-slate-500">{ grantScope(g) }</div>
								</div>
								<div class="flex shrink-0 items-center gap-2">
									@deleteButton("/admin/grants/delete", g.ID, g.Role)
								</div>
							</li>
						}
					</ul>
				}
			</div>
		}
	}
}
