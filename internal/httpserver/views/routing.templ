package views

import "github.com/pflege-de-labs/teamster/internal/i18n"

templ RoutingPage(viewer Viewer) {
	@Layout(i18n.T(ctx, "page.routing"), &viewer) {
		<section class="rounded-lg border border-slate-200 bg-white shadow-sm">
			<h2 class="border-b border-slate-200 px-6 py-4 text-lg font-semibold">{ i18n.T(ctx, "routing.match_heading") }</h2>
			<div class="grid gap-8 px-6 py-6 lg:grid-cols-3">
				<form id="match-form" class="space-y-3 lg:col-span-1">
					@textareaField("labels", i18n.T(ctx, "routing.labels_field"), "severity=critical\nalertname=HighCPU", "6")
					@submit(i18n.T(ctx, "routing.check"))
					<div id="match-result" class="empty:hidden"></div>
				</form>
				<div class="lg:col-span-2">
					<div class="mb-3 flex flex-wrap gap-3 text-xs text-slate-600">
						@legendSwatch("bg-slate-500", i18n.T(ctx, "routing.legend_webhook"))
						@legendSwatch("bg-sky-500", i18n.T(ctx, "routing.legend_route"))
						@legendSwatch("bg-emerald-500", i18n.T(ctx, "routing.legend_destination"))
						@legendSwatch("bg-red-500", i18n.T(ctx, "routing.legend_missing"))
						@legendSwatch("bg-indigo-600", i18n.T(ctx, "routing.legend_match"))
					</div>
					<div id="routing-graph" class="h-[32rem] w-full rounded-md border border-slate-200 bg-slate-50"></div>
					<p class="mt-2 text-xs text-slate-500">{ i18n.T(ctx, "routing.graph_help") }</p>
				</div>
			</div>
		</section>
		<section class="mt-8 rounded-lg border border-slate-200 bg-white shadow-sm">
			<h2 class="border-b border-slate-200 px-6 py-4 text-lg font-semibold">{ i18n.T(ctx, "routing.templates_heading") }</h2>
			<div class="px-6 py-6">
				<p class="mb-3 text-xs text-slate-500">{ i18n.T(ctx, "routing.templates_help") }</p>
				<div id="template-graph" class="h-80 w-full rounded-md border border-slate-200 bg-slate-50"></div>
			</div>
		</section>
	}
}

templ legendSwatch(colour, label string) {
	<span class="inline-flex items-center gap-1.5">
		<span class={ "inline-block h-2.5 w-2.5 rounded-full", colour }></span>
		{ label }
	</span>
}
