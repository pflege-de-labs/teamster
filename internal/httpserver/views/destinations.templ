package views

import (
	"net/url"

	"github.com/pflege-de-labs/teamster/internal/i18n"
	"github.com/pflege-de-labs/teamster/internal/models"
)

// DestinationRow is a destination and whether the Teams app is installed in its team.
type DestinationRow struct {
	Destination  models.Destination
	InstallState string // "installed" | "missing" | "unknown"
}

// DestinationList is the page at /admin/destinations.
type DestinationList struct {
	Viewer        Viewer
	Notice, Error string
	Rows          []DestinationRow
	CanCreate     bool
}

// DestinationRecord is the page at /admin/destinations/{id}.
type DestinationRecord struct {
	Viewer                               Viewer
	Notice, Error                        string
	Destination                          models.Destination // as stored
	Form                                 models.Destination // values the form shows
	InstallState                         string
	CanUpdate, CanDelete, CanMakeDefault bool
	Routes, Webhooks                     []UsedBy
	Sharing                              *Sharing
	BrokerAvailable                      bool
	Head                                 RecordHead
}

// DestinationNew is the page at /admin/destinations/new.
type DestinationNew struct {
	Viewer          Viewer
	Error           string
	Form            models.Destination
	BrokerAvailable bool
}

templ DestinationListPage(p DestinationList) {
	@Layout(i18n.T(ctx, "page.destinations"), &p.Viewer) {
		@notice(p.Error, p.Notice)
		@listPage(i18n.T(ctx, "nav.destinations"), i18n.T(ctx, "destinations.new"), "/admin/destinations/new", p.CanCreate) {
			if len(p.Rows) == 0 {
				@empty(i18n.T(ctx, "destinations.empty"))
			} else {
				<ul class="divide-y divide-slate-200">
					for _, row := range p.Rows {
						<li class="py-3">
							<div class="flex items-center gap-2">
								<a href={ templ.SafeURL("/admin/destinations/" + url.PathEscape(row.Destination.ID)) } class="truncate font-medium text-sky-700 hover:underline">{ row.Destination.Name }</a>
								if row.Destination.IsDefault {
									<span class="rounded bg-sky-100 px-1.5 py-0.5 text-xs font-medium text-sky-800">{ i18n.T(ctx, "destinations.badge_global_default") }</span>
								}
								if row.InstallState == "missing" {
									<a href="/admin/teams" class="rounded bg-amber-100 px-1.5 py-0.5 text-xs font-medium text-amber-900">{ i18n.T(ctx, "destinations.badge_app_missing") }</a>
								}
							</div>
							<div class="truncate text-xs text-slate-500">team { row.Destination.TeamID } · channel { row.Destination.ChannelID }</div>
						</li>
					}
				</ul>
			}
		}
	}
}

templ DestinationRecordPage(p DestinationRecord) {
	@Layout(i18n.T(ctx, "page.destinations"), &p.Viewer) {
		@notice(p.Error, p.Notice)
		if p.CanUpdate {
			@recordPage(p.Head, destinationActions(p), destinationView(p), destinationForm(p.Form, p.BrokerAvailable, "/admin/destinations/"+url.PathEscape(p.Destination.ID)))
		} else {
			@recordPage(p.Head, destinationActions(p), destinationView(p), nil)
		}
		if p.Sharing != nil {
			@sharingPanel(*p.Sharing)
		}
	}
}

templ DestinationNewPage(p DestinationNew) {
	@Layout(i18n.T(ctx, "page.destinations"), &p.Viewer) {
		@notice(p.Error, "")
		@newPage("/admin/destinations", i18n.T(ctx, "nav.destinations"), i18n.T(ctx, "destinations.new")) {
			@destinationForm(p.Form, p.BrokerAvailable, "/admin/destinations")
		}
	}
}

templ destinationActions(p DestinationRecord) {
	if p.CanMakeDefault {
		@makeDefaultButton(p.Destination.ID, p.Destination.Name)
	}
	if p.CanDelete {
		@deleteButton("/admin/destinations/delete", p.Destination.ID, p.Destination.Name)
	}
}

templ destinationView(p DestinationRecord) {
	<dl class="grid grid-cols-[max-content_1fr] gap-x-6 gap-y-2 text-sm">
		<dt class="text-slate-500">{ i18n.T(ctx, "templates.name") }</dt>
		<dd class="flex items-center gap-2">
			<span class="font-medium">{ p.Destination.Name }</span>
			if p.Destination.IsDefault {
				<span class="rounded bg-sky-100 px-1.5 py-0.5 text-xs font-medium text-sky-800">{ i18n.T(ctx, "destinations.badge_global_default") }</span>
			}
		</dd>
		<dt class="text-slate-500">{ i18n.T(ctx, "destinations.team") }</dt>
		<dd class="font-mono text-xs" data-team-id={ p.Destination.TeamID }>{ p.Destination.TeamID }</dd>
		<dt class="text-slate-500">{ i18n.T(ctx, "destinations.channel") }</dt>
		<dd class="font-mono text-xs" data-team-id={ p.Destination.TeamID } data-channel-id={ p.Destination.ChannelID }>{ p.Destination.ChannelID }</dd>
		<dt class="text-slate-500">{ i18n.T(ctx, "destinations.install") }</dt>
		<dd>{ i18n.T(ctx, "install.state_" + p.InstallState) }</dd>
	</dl>
	<section class="space-y-2">
		<h3 class="text-sm font-semibold">{ i18n.T(ctx, "destinations.used_by") }</h3>
		if len(p.Routes) == 0 && len(p.Webhooks) == 0 {
			<p class="text-sm text-slate-500">{ i18n.T(ctx, "destinations.unused") }</p>
		} else {
			<ul class="space-y-1 text-sm">
				for _, u := range p.Routes {
					<li><a href={ templ.SafeURL(u.Href) } class="text-sky-700 hover:underline">{ u.Label }</a></li>
				}
				for _, u := range p.Webhooks {
					<li><a href={ templ.SafeURL(u.Href) } class="text-sky-700 hover:underline">{ u.Label }</a></li>
				}
			</ul>
		}
		<a href="/admin/routing" class="text-xs text-sky-700 hover:underline">{ i18n.T(ctx, "nav.routing") }</a>
	</section>
}

// The form still posts to the list URL; the save target moves with the new page.
templ destinationForm(form models.Destination, brokerAvailable bool, cancelHref string) {
	<form method="post" action="/admin/destinations" class="space-y-3">
		if form.ID != "" {
			<input type="hidden" name="id" value={ form.ID }/>
		}
		@textField("name", i18n.T(ctx, "templates.name"), i18n.T(ctx, "destinations.name_placeholder"), form.Name)
		@pickerField("destination-team", "team_id", i18n.T(ctx, "destinations.team"), "team-id", form.TeamID, i18n.T(ctx, "picker.team"), i18n.T(ctx, "picker.team_choose"), "", brokerAvailable, i18n.T(ctx, "picker.all_teams"), i18n.T(ctx, "picker.my_teams"))
		@pickerField("destination-channel", "channel_id", i18n.T(ctx, "destinations.channel"), "channel-id", form.ChannelID, i18n.T(ctx, "picker.channel"), i18n.T(ctx, "picker.channel_choose"), i18n.T(ctx, "picker.channel_needs_team"), false, "", "")
		<p id="destination-channel-hint" hidden class="text-xs text-slate-500">{ i18n.T(ctx, "picker.channel_needs_team") }</p>
		<p
			id="destination-install-hint"
			hidden
			class="rounded-md border border-amber-300 bg-amber-50 px-3 py-2 text-xs text-amber-900"
			data-group-installed={ i18n.T(ctx, "install.group_installed") }
			data-group-missing={ i18n.T(ctx, "install.group_missing") }
			data-group-unknown={ i18n.T(ctx, "install.group_unknown") }
			data-text-missing={ i18n.T(ctx, "install.hint_missing") }
			data-text-unknown={ i18n.T(ctx, "install.hint_unknown") }
		>
			<span data-install-text></span>
			<a href="/admin/teams" class="underline">{ i18n.T(ctx, "install.hint_link") }</a>
		</p>
		<div class="flex items-center gap-2">
			@submit(submitLabel(ctx, form.ID != "", "noun.destination"))
			<a href={ templ.SafeURL(cancelHref) } data-record-cancel class="px-3 py-2 text-sm text-slate-600 underline hover:text-slate-900">{ i18n.T(ctx, "action.cancel") }</a>
		</div>
	</form>
}

// Switching the global default is its own form, like rotating a webhook token,
// because it changes where every unclaimed message goes.
templ makeDefaultButton(id, name string) {
	<form method="post" action="/admin/destinations/default">
		<input type="hidden" name="id" value={ id }/>
		<button
			type="submit"
			aria-label={ i18n.T(ctx, "destinations.make_default") + " " + name }
			class="rounded-md border border-slate-300 px-3 py-1.5 text-sm text-slate-700 hover:border-sky-400 hover:bg-sky-50 hover:text-sky-700"
		>
			{ i18n.T(ctx, "destinations.make_default") }
		</button>
	</form>
}
