package views

import (
	"github.com/pflege-de-labs/teamster/internal/i18n"
	"github.com/pflege-de-labs/teamster/internal/models"
)

// Tokens is the page at /admin/tokens: the access tokens that admit a sender to
// /webhook/alertmanager and /webhook/universal (ADR 0044).
type Tokens struct {
	Viewer Viewer
	Tokens []models.AccessToken
	// NewToken is set only on the answer to the post that created it.
	NewToken     string
	NewTokenName string
	// WebhookURL is what the Alertmanager snippet points at.
	WebhookURL string
	// ConfigTokenSet says whether webhook.token also admits senders.
	ConfigTokenSet bool
	Notice         string
	Error          string
}

templ TokensPage(page Tokens) {
	@Layout(i18n.T(ctx, "page.tokens"), &page.Viewer) {
		@notice(page.Error, page.Notice)
		<section class="rounded-lg border border-slate-200 bg-white shadow-sm">
			<h2 class="border-b border-slate-200 px-6 py-4 text-lg font-semibold">
				{ i18n.T(ctx, "tokens.heading") }
			</h2>
			<div class="grid gap-8 px-6 py-6 lg:grid-cols-2">
				<form method="post" action="/admin/tokens/new" class="space-y-3">
					<p class="text-sm text-slate-600">{ i18n.T(ctx, "tokens.explainer") }</p>
					@textField("name", i18n.T(ctx, "tokens.name"), i18n.T(ctx, "tokens.name_placeholder"), "")
					@submit(i18n.T(ctx, "tokens.create"))
					if page.ConfigTokenSet {
						<p class="text-xs text-slate-500">{ i18n.T(ctx, "tokens.config_token") }</p>
					}
				</form>
				<div>
					if page.NewToken != "" {
						@revealedToken(page)
					}
					if len(page.Tokens) == 0 {
						@empty(i18n.T(ctx, "tokens.empty"))
					} else {
						<ul class="divide-y divide-slate-200">
							for _, t := range page.Tokens {
								@tokenItem(t)
							}
						</ul>
					}
				</div>
			</div>
		</section>
	}
}

templ tokenItem(t models.AccessToken) {
	<li class="flex items-center justify-between gap-4 py-3">
		<div class="min-w-0">
			<div class="truncate font-medium">{ t.Name }</div>
			<div class="truncate text-xs text-slate-500">
				{ i18n.T(ctx, "tokens.created", stamp(ctx, t.CreatedAt), t.CreatedBy) }
			</div>
			<div class="truncate text-xs text-slate-500">
				if t.LastUsedAt.IsZero() {
					{ i18n.T(ctx, "tokens.never_used") }
				} else {
					{ i18n.T(ctx, "tokens.last_used", stamp(ctx, t.LastUsedAt)) }
				}
			</div>
		</div>
		<form method="post" action="/admin/tokens/delete" class="shrink-0">
			<input type="hidden" name="id" value={ t.ID }/>
			<button
				type="submit"
				aria-label={ i18n.T(ctx, "tokens.revoke") + " " + t.Name }
				class="rounded-md border border-slate-300 px-3 py-1.5 text-sm text-slate-700 hover:border-red-400 hover:bg-red-50 hover:text-red-700"
			>
				{ i18n.T(ctx, "tokens.revoke") }
			</button>
		</form>
	</li>
}

templ revealedToken(page Tokens) {
	<div class="mb-4 space-y-2 rounded-md border border-amber-300 bg-amber-50 px-4 py-3">
		<p class="text-sm font-medium text-amber-900">{ i18n.T(ctx, "tokens.new_token", page.NewTokenName) }</p>
		<code class="block break-all text-xs text-amber-900">{ page.NewToken }</code>
		<p class="text-xs text-amber-900">{ i18n.T(ctx, "tokens.snippet") }</p>
		<pre class="overflow-x-auto rounded bg-white/60 p-2 text-xs text-amber-900"><code>{ alertmanagerSnippet(page.WebhookURL, page.NewToken) }</code></pre>
	</div>
}

func alertmanagerSnippet(url, token string) string {
	return "receivers:\n" +
		"  - name: teamster\n" +
		"    webhook_configs:\n" +
		"      - url: " + url + "\n" +
		"        http_config:\n" +
		"          authorization:\n" +
		"            type: Bearer\n" +
		"            credentials: " + token + "\n"
}
