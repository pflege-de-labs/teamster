package views

import "github.com/pflege-de-labs/teamster/internal/i18n"

templ Layout(title string, viewer *Viewer) {
	<!DOCTYPE html>
	<html lang={ i18n.LanguageOf(ctx) }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<link rel="icon" href="/favicon.ico" sizes="48x48"/>
			<link rel="icon" type="image/png" href="/icons/favicon-32x32.png" sizes="32x32"/>
			<link rel="icon" type="image/png" href="/icons/favicon-16x16.png" sizes="16x16"/>
			<link rel="apple-touch-icon" href="/icons/apple-touch-icon.png"/>
			<link rel="manifest" href="/site.webmanifest"/>
			<meta name="theme-color" content="#79d0fd"/>
			<link rel="stylesheet" href="/styles.css"/>
			if viewer != nil && viewer.CanComplete {
				<meta name="teamster-samples" content="/api/samples"/>
			}
			// Bare specifiers for the vendored CodeMirror modules editor.js imports; see ADR 0041.
			<script type="importmap">
				{
					"imports": {
						"@codemirror/autocomplete": "/vendor/codemirror-autocomplete.js",
						"@codemirror/commands": "/vendor/codemirror-commands.js",
						"@codemirror/lang-json": "/vendor/codemirror-lang-json.js",
						"@codemirror/language": "/vendor/codemirror-language.js",
						"@codemirror/state": "/vendor/codemirror-state.js",
						"@codemirror/view": "/vendor/codemirror-view.js",
						"@lezer/common": "/vendor/lezer-common.js",
						"@lezer/highlight": "/vendor/lezer-highlight.js",
						"@lezer/json": "/vendor/lezer-json.js",
						"@lezer/lr": "/vendor/lezer-lr.js",
						"@marijn/find-cluster-break": "/vendor/find-cluster-break.js",
						"crelt": "/vendor/crelt.js",
						"style-mod": "/vendor/style-mod.js",
						"w3c-keyname": "/vendor/w3c-keyname.js"
					}
				}
			</script>
		</head>
		<body class="min-h-screen bg-slate-50 text-slate-900">
			<header class="border-b border-slate-200 bg-white">
				<div class="flex items-center gap-3 px-6 py-4">
					if viewer != nil {
						<button
							type="button"
							id="nav-toggle"
							hidden
							aria-controls="sidebar"
							aria-expanded="true"
							aria-label={ i18n.T(ctx, "nav.toggle") }
							class="rounded-md p-1.5 text-slate-600 hover:bg-slate-100 hover:text-slate-900"
						>
							<svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
								<path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16"></path>
							</svg>
						</button>
					}
					<img src="/icons/favicon-48x48.png" alt="" width="40" height="40" class="rounded-full"/>
					<div class="grow">
						<div class="text-xl font-semibold">{ i18n.T(ctx, "app.title") }</div>
						<div class="text-sm text-slate-500">{ i18n.T(ctx, "app.subtitle") }</div>
					</div>
					if viewer != nil {
						@userMenu(*viewer)
					} else {
						@languagePicker(languageOf(ctx))
					}
				</div>
			</header>
			if viewer != nil {
				<div class="flex min-h-[calc(100vh-4.5rem)]">
					@sidebar(*viewer)
					<main class="mx-auto min-w-0 max-w-6xl grow space-y-8 px-6 py-8">
						{ children... }
					</main>
				</div>
			} else {
				<main class="mx-auto max-w-6xl space-y-8 px-6 py-8">
					{ children... }
				</main>
			}
			<script src="/vendor/adaptivecards.min.js"></script>
			<script src="/preview.js"></script>
			<script src="/sources.js"></script>
			<script src="/pickers.js"></script>
			<script src="/vendor/d3.min.js"></script>
			<script src="/routing.js"></script>
			<script src="/language.js"></script>
			<script src="/nav.js"></script>
			<script src="/permissions.js"></script>
			<script type="module" src="/editor.js"></script>
		</body>
	</html>
}

// notice takes the two strings rather than a Page, so a page of its own --
// Recipients, say -- can show the outcome of its own form post the same way
// without depending on Page's shape.
templ notice(errorText, noticeText string) {
	if errorText != "" {
		<div role="alert" class="rounded-md border border-red-300 bg-red-50 px-4 py-3 text-sm text-red-800">
			{ errorText }
		</div>
	} else if noticeText != "" {
		<div role="status" class="rounded-md border border-emerald-300 bg-emerald-50 px-4 py-3 text-sm text-emerald-800">
			{ noticeText }
		</div>
	}
}

templ panel(title, id string) {
	<section id={ id } class="scroll-mt-4 rounded-lg border border-slate-200 bg-white shadow-sm">
		<h2 class="border-b border-slate-200 px-6 py-4 text-lg font-semibold">{ title }</h2>
		<div class="grid gap-8 px-6 py-6 lg:grid-cols-2">
			{ children... }
		</div>
	</section>
}
