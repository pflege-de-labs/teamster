package views

templ LoginPage(page Login) {
	@Layout("Sign in — Teamster", nil) {
		<div class="mx-auto max-w-md space-y-6">
			if page.Error != "" {
				<div role="alert" class="rounded-md border border-amber-300 bg-amber-50 px-4 py-3 text-sm text-amber-900">
					{ page.Error }
				</div>
			}
			<section class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
				<h2 class="text-lg font-semibold">Sign in</h2>
				if page.OIDC {
					<a
						href="/admin/auth/start"
						class="mt-4 block rounded-md bg-sky-600 px-4 py-2 text-center text-sm font-medium text-white shadow-sm hover:bg-sky-700"
					>
						Sign in with your identity provider
					</a>
				}
				if page.OIDC && page.LocalLogin {
					<p class="my-4 text-center text-xs uppercase tracking-wide text-slate-400">or</p>
				}
				if page.LocalLogin {
					<form method="post" action="/admin/login" class="mt-4 space-y-3">
						@textField("username", "Username", "admin", "")
						<label class="block">
							<span class="text-sm font-medium">Password</span>
							<input
								type="password"
								name="password"
								autocomplete="current-password"
								class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-sky-500 focus:outline-none"
							/>
						</label>
						@submit("Sign in")
					</form>
				}
				if !page.OIDC && !page.LocalLogin {
					@empty("No way to sign in is configured. Set admin credentials or an OIDC issuer.")
				}
			</section>
		</div>
	}
}
