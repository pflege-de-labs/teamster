package views

import (
	"strings"

	"github.com/pflege-de-labs/teamster/internal/i18n"
	"github.com/pflege-de-labs/teamster/internal/models"
)

// Users is the page at /admin/users: everyone who has signed in (ADR 0072).
type Users struct {
	Viewer Viewer
	Search string
	Users  []models.User
	// Self is the viewer's subject, whom the page will not disable.
	Self   string
	Notice string
	Error  string
}

templ UsersPage(page Users) {
	@Layout(i18n.T(ctx, "page.users"), &page.Viewer) {
		@notice(page.Error, page.Notice)
		<section class="rounded-lg border border-slate-200 bg-white shadow-sm">
			<h2 class="border-b border-slate-200 px-6 py-4 text-lg font-semibold">
				{ i18n.T(ctx, "users.heading") }
			</h2>
			<div class="space-y-6 px-6 py-6">
				<p class="text-sm text-slate-600">{ i18n.T(ctx, "users.explainer") }</p>
				<form method="get" action="/admin/users" class="flex max-w-xl items-end gap-2">
					<div class="grow">
						@textField("q", i18n.T(ctx, "users.search"), i18n.T(ctx, "users.search_placeholder"), page.Search)
					</div>
					@submit(i18n.T(ctx, "users.find"))
				</form>
				if len(page.Users) == 0 {
					@empty(i18n.T(ctx, "users.empty"))
				} else {
					<ul class="divide-y divide-slate-200">
						for _, u := range page.Users {
							@userItem(u, page.Self)
						}
					</ul>
				}
			</div>
		</section>
	}
}

templ userItem(u models.User, self string) {
	<li class="flex items-center justify-between gap-4 py-3">
		<div class="min-w-0">
			<div class="truncate font-medium">
				{ displayName(u) }
				if u.Disabled() {
					<span class="ml-2 rounded bg-red-50 px-1.5 py-0.5 text-xs font-medium text-red-700">{ i18n.T(ctx, "users.disabled") }</span>
				}
			</div>
			<div class="truncate font-mono text-xs text-slate-500">{ u.Subject }</div>
			<div class="truncate text-xs text-slate-500">
				{ i18n.T(ctx, "users.detail", u.Source, joinOrDash(u.Roles), joinOrDash(u.IdPGroups), stamp(ctx, u.LastSeen)) }
			</div>
			if u.Disabled() {
				<div class="truncate text-xs text-red-700">{ i18n.T(ctx, "users.disabled_by", u.DisabledBy, stamp(ctx, u.DisabledAt)) }</div>
			}
		</div>
		if u.Source != "local" && u.Subject != self {
			<form method="post" action={ templ.SafeURL(userToggleAction(u)) } class="shrink-0">
				<input type="hidden" name="subject" value={ u.Subject }/>
				<button
					type="submit"
					class="rounded-md border border-slate-300 px-3 py-1.5 text-sm text-slate-700 hover:border-red-400 hover:bg-red-50 hover:text-red-700"
				>
					if u.Disabled() {
						{ i18n.T(ctx, "users.enable") }
					} else {
						{ i18n.T(ctx, "users.disable") }
					}
				</button>
			</form>
		}
	</li>
}

func displayName(u models.User) string {
	if u.Name != "" {
		return u.Name
	}
	return u.Subject
}

func joinOrDash(values []string) string {
	if len(values) == 0 {
		return "—"
	}
	return strings.Join(values, ", ")
}

func userToggleAction(u models.User) string {
	if u.Disabled() {
		return "/admin/users/enable"
	}
	return "/admin/users/disable"
}
