package views

// NoAccess is what a signed-in user sees when their claim named no role. The
// sign-in worked; it is the permissions that are missing, and saying so is the
// difference between "ask your administrator" and "this thing is broken".
templ NoAccess(name string) {
	@Layout("No access — Teamster", true) {
		<section class="mx-auto max-w-2xl rounded-lg border border-slate-200 bg-white p-8 shadow-sm">
			<h2 class="text-lg font-semibold">You are signed in, but have no permissions</h2>
			if name != "" {
				<p class="mt-3 text-sm text-slate-600">
					Signed in as { name }. Your account carries no Teamster role, so there is nothing here you
					may see or change yet.
				</p>
			} else {
				<p class="mt-3 text-sm text-slate-600">
					Your account carries no Teamster role, so there is nothing here you may see or change yet.
				</p>
			}
			<p class="mt-3 text-sm text-slate-600">
				Ask an administrator to grant you the <span class="font-medium">viewer</span>,
				<span class="font-medium">editor</span> or <span class="font-medium">admin</span> role in the
				identity provider, then sign in again — a role is read when you sign in.
			</p>
		</section>
	}
}
