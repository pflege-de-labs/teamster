package views

import "github.com/pflege-de-labs/teamster/internal/i18n"

// NoAccess is what a signed-in user sees when their claim named no role. The
// sign-in worked; it is the permissions that are missing, and saying so is the
// difference between "ask your administrator" and "this thing is broken".
templ NoAccess(viewer Viewer) {
	@Layout(i18n.T(ctx, "page.noaccess"), &viewer) {
		<section class="mx-auto max-w-2xl rounded-lg border border-slate-200 bg-white p-8 shadow-sm">
			<h2 class="text-lg font-semibold">{ i18n.T(ctx, "noaccess.heading") }</h2>
			if viewer.Name != "" {
				<p class="mt-3 text-sm text-slate-600">{ i18n.T(ctx, "noaccess.signed_in_as", viewer.Name) }</p>
			} else {
				<p class="mt-3 text-sm text-slate-600">{ i18n.T(ctx, "noaccess.anonymous") }</p>
			}
			<p class="mt-3 text-sm text-slate-600">{ i18n.T(ctx, "noaccess.ask") }</p>
		</section>
	}
}
