package views

import (
	"github.com/pflege-de-labs/teamster/internal/authz"
	"github.com/pflege-de-labs/teamster/internal/i18n"
	"github.com/pflege-de-labs/teamster/internal/models"
)

// Access is the admins' overview at /admin/access (ADR 0076).
type Access struct {
	Viewer Viewer
	// Admin is whether the viewer administers access; everyone else gets the
	// hub and the grants on records they may share, and nothing else here.
	Admin bool
	Hub   *Hub
	// Records name every record for the "Who can?" form.
	Records []HubClass
	Webhooks   []WebhookAccess
	// Messages are the principals granted a message level (ADR 0082).
	Messages   []WebhookAccess
	Grants     []LabelledGrant
	Filter     string
	BaseText   string
	Generated  []authz.GeneratedPolicy
	Generation int64
	Check      *AccessCheck
	Notice     string
	Error      string
}

// HubRecord is a record a grant may name, with where to edit it.
type HubRecord struct {
	ID       string
	Name     string
	Href     string
	CanShare bool
}

// HubClass is a resource type and its records.
type HubClass struct {
	Type    string
	Records []HubRecord
}

// Hub is the picker: a class, its records, and the grants of one record.
type Hub struct {
	Classes    []HubClass
	Class      string
	Records    []HubRecord
	SelectedID string
	Selected   *Sharing
	Principals PrincipalOptions
	// Actions are what a batch may grant; ownership is passed on one record at a time.
	Actions []string
}

// WebhookAccess is one principal's webhook level.
type WebhookAccess struct {
	PrincipalType string
	PrincipalID   string
	Label         string
	Level         string
}

// LabelledGrant is a permission with names for its principal and resource.
type LabelledGrant struct {
	Permission models.Permission
	Principal  string
	Resource   string
	// Href is the record's edit page, empty for what has none.
	Href string
}

// AccessCheck is the question asked in "Who can?" and its answer.
type AccessCheck struct {
	Subject      string
	Action       string
	ResourceType string
	ResourceID   string
	Known        bool
	Result       authz.Explanation
}

// WebhookLevels are the choices the webhook form offers, weakest first.
var WebhookLevels = []string{"none", "alertmanager", "universal", "all", "admin"}

// MessageLevels are the choices the message form offers, weakest first.
var MessageLevels = []string{"none", "anyone", "everyone"}

templ AccessPage(page Access) {
	@Layout(i18n.T(ctx, "page.access"), &page.Viewer) {
		@notice(page.Error, page.Notice)
		<div class="space-y-6">
			@accessSection(i18n.T(ctx, "hub.heading")) {
				@hubPicker(page.Hub)
			}
			if page.Admin {
			@accessSection(i18n.T(ctx, "access.webhooks")) {
				<p class="text-sm text-slate-600">{ i18n.T(ctx, "access.webhooks_explainer") }</p>
				if len(page.Webhooks) > 0 {
					<ul class="divide-y divide-slate-200">
						for _, w := range page.Webhooks {
							<li class="flex justify-between py-2 text-sm">
								<span>
									<span class="mr-2 rounded bg-slate-100 px-1.5 py-0.5 text-xs text-slate-600">{ i18n.T(ctx, "sharing.principal."+w.PrincipalType) }</span>
									{ w.Label }
								</span>
								<span class="font-mono text-xs">{ i18n.T(ctx, "access.level."+w.Level) }</span>
							</li>
						}
					</ul>
				}
				<form method="post" action="/admin/access/webhooks" class="grid gap-3 sm:grid-cols-4 sm:items-end">
					<label class="block">
						<span class="text-sm font-medium">{ i18n.T(ctx, "sharing.principal_type") }</span>
						<select name="principal_type" class="mt-1 block w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm shadow-sm">
							for _, t := range []string{"user", "group", "idp_group", "role"} {
								<option value={ t }>{ i18n.T(ctx, "sharing.principal."+t) }</option>
							}
						</select>
					</label>
					@textField("principal_id", i18n.T(ctx, "sharing.principal"), "", "")
					<label class="block">
						<span class="text-sm font-medium">{ i18n.T(ctx, "access.level") }</span>
						<select name="level" class="mt-1 block w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm shadow-sm">
							for _, level := range WebhookLevels {
								<option value={ level }>{ i18n.T(ctx, "access.level."+level) }</option>
							}
						</select>
					</label>
					@submit(i18n.T(ctx, "sharing.grant"))
				</form>
			}
			@accessSection(i18n.T(ctx, "access.messages")) {
				<p class="text-sm text-slate-600">{ i18n.T(ctx, "access.messages_explainer") }</p>
				if len(page.Messages) > 0 {
					<ul class="divide-y divide-slate-200">
						for _, m := range page.Messages {
							<li class="flex justify-between py-2 text-sm">
								<span>
									<span class="mr-2 rounded bg-slate-100 px-1.5 py-0.5 text-xs text-slate-600">{ i18n.T(ctx, "sharing.principal."+m.PrincipalType) }</span>
									{ m.Label }
								</span>
								<span class="font-mono text-xs">{ i18n.T(ctx, "access.message_level."+m.Level) }</span>
							</li>
						}
					</ul>
				}
				<form method="post" action="/admin/access/messages" class="grid gap-3 sm:grid-cols-4 sm:items-end">
					<label class="block">
						<span class="text-sm font-medium">{ i18n.T(ctx, "sharing.principal_type") }</span>
						<select name="principal_type" class="mt-1 block w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm shadow-sm">
							for _, t := range []string{"user", "group", "idp_group", "role"} {
								<option value={ t }>{ i18n.T(ctx, "sharing.principal."+t) }</option>
							}
						</select>
					</label>
					@textField("principal_id", i18n.T(ctx, "sharing.principal"), "", "")
					<label class="block">
						<span class="text-sm font-medium">{ i18n.T(ctx, "access.level") }</span>
						<select name="level" class="mt-1 block w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm shadow-sm">
							for _, level := range MessageLevels {
								<option value={ level }>{ i18n.T(ctx, "access.message_level."+level) }</option>
							}
						</select>
					</label>
					@submit(i18n.T(ctx, "sharing.grant"))
				</form>
			}
			@accessSection(i18n.T(ctx, "access.check")) {
				<form method="get" action="/admin/access" class="grid gap-3 sm:grid-cols-4 sm:items-end">
					@textField("subject", i18n.T(ctx, "access.subject"), "", checkValue(page.Check, "subject"))
					<label class="block">
						<span class="text-sm font-medium">{ i18n.T(ctx, "audit.action") }</span>
						<select name="action" class="mt-1 block w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm shadow-sm">
							for _, a := range checkActions {
								<option value={ a } selected?={ a == checkValue(page.Check, "action") }>{ i18n.T(ctx, "sharing.action."+a) }</option>
							}
						</select>
					</label>
					<label class="block">
						<span class="text-sm font-medium">{ i18n.T(ctx, "access.resource") }</span>
						<select name="resource" class="mt-1 block w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm shadow-sm">
							for _, class := range page.Records {
								<optgroup label={ i18n.T(ctx, "hub.class."+class.Type) }>
									for _, rec := range class.Records {
										<option value={ class.Type + ":" + rec.ID } selected?={ class.Type+":"+rec.ID == checkValue(page.Check, "resource") }>{ rec.Name }</option>
									}
								</optgroup>
							}
						</select>
					</label>
					@submit(i18n.T(ctx, "access.ask"))
				</form>
				if page.Check != nil {
					if !page.Check.Known {
						<p class="text-sm text-amber-800">{ i18n.T(ctx, "access.unknown_user") }</p>
					}
					if page.Check.Result.Allowed {
						<p class="text-sm font-medium text-emerald-700">{ i18n.T(ctx, "access.allowed") }</p>
					} else {
						<p class="text-sm font-medium text-red-700">{ i18n.T(ctx, "access.refused") }</p>
					}
					for _, p := range page.Check.Result.Policies {
						<details><summary class="cursor-pointer text-xs text-slate-500">{ p.ID }</summary><pre class="overflow-x-auto rounded bg-slate-50 p-2 text-xs"><code>{ p.Text }</code></pre></details>
					}
				}
			}
			}
			@accessSection(i18n.T(ctx, "access.grants")) {
				<form method="get" action="/admin/access" class="flex max-w-xl items-end gap-2">
					<div class="grow">
						@textField("filter", i18n.T(ctx, "access.filter"), "Template", page.Filter)
					</div>
					@submit(i18n.T(ctx, "audit.filter"))
				</form>
				if len(page.Grants) == 0 {
					@empty(i18n.T(ctx, "access.no_grants"))
				} else {
					<table class="w-full text-left text-sm">
						<thead class="text-xs text-slate-500">
							<tr>
								<th class="py-1">{ i18n.T(ctx, "sharing.principal") }</th>
								<th class="py-1">{ i18n.T(ctx, "access.resource") }</th>
								<th class="py-1">{ i18n.T(ctx, "sharing.actions") }</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-slate-100">
							for _, g := range page.Grants {
								<tr>
									<td class="py-1">{ g.Principal }</td>
									<td class="py-1">
										if g.Href != "" {
											<a href={ templ.SafeURL(g.Href) } class="text-sky-700 hover:underline">{ g.Resource }</a>
										} else {
											{ g.Resource }
										}
									</td>
									<td class="py-1 font-mono text-xs">{ joinOrDash(g.Permission.Actions) }</td>
								</tr>
							}
						</tbody>
					</table>
				}
			}
			if page.Admin {
			@accessSection(i18n.T(ctx, "access.policies")) {
				<p class="text-xs text-slate-500">{ i18n.T(ctx, "access.generation", page.Generation) }</p>
				<details>
					<summary class="cursor-pointer text-sm font-medium">{ i18n.T(ctx, "access.base") }</summary>
					<pre class="mt-2 overflow-x-auto rounded bg-slate-50 p-3 text-xs"><code>{ page.BaseText }</code></pre>
				</details>
				for _, p := range page.Generated {
					<pre class="overflow-x-auto rounded bg-slate-50 p-2 text-xs"><code>{ p.Text }</code></pre>
				}
			}
			}
		</div>
	}
}

templ accessSection(title string) {
	<section class="rounded-lg border border-slate-200 bg-white shadow-sm">
		<h2 class="border-b border-slate-200 px-6 py-4 text-lg font-semibold">{ title }</h2>
		<div class="space-y-4 px-6 py-6">
			{ children... }
		</div>
	</section>
}

func checkValue(check *AccessCheck, field string) string {
	if check == nil {
		return ""
	}
	switch field {
	case "subject":
		return check.Subject
	case "action":
		return check.Action
	case "type":
		return check.ResourceType
	default:
		return check.ResourceType + ":" + check.ResourceID
	}
}

// checkActions are what "Who can?" asks about.
var checkActions = []string{"read", "update", "delete", "attach", "share", "own", "create", "use", "administer", "message", "broadcast"}

// MyAccess is /admin/me: what the signed-in person may do, and why.
type MyAccess struct {
	Viewer    Viewer
	Subject   string
	Roles     []string
	IdPGroups []string
	Groups    []string
	Webhooks  []string
	// Messages is how far they may address people (ADR 0082).
	Messages  string
	Policies  []authz.GeneratedPolicy
	// Granted is what was shared with the viewer; Roles what their roles allow on whole collections.
	Granted    []MyGrant
	RoleGrants []RoleSummary
	Error   string
}

// MyGrant is a record the viewer holds actions on, and through whom.
type MyGrant struct {
	Type    string
	Name    string
	Href    string
	Actions []string
	Via     []string
}

// RoleSummary is what one role allows on every record of a type.
type RoleSummary struct {
	Role    string
	Type    string
	Actions []string
}

templ MyAccessPage(page MyAccess) {
	@Layout(i18n.T(ctx, "page.me"), &page.Viewer) {
		@notice(page.Error, "")
		@accessSection(i18n.T(ctx, "me.heading")) {
			<dl class="grid gap-2 text-sm sm:grid-cols-4">
				<dt class="font-medium">{ i18n.T(ctx, "access.subject") }</dt>
				<dd class="font-mono text-xs sm:col-span-3">{ page.Subject }</dd>
				<dt class="font-medium">{ i18n.T(ctx, "me.roles") }</dt>
				<dd class="sm:col-span-3">{ joinOrDash(page.Roles) }</dd>
				<dt class="font-medium">{ i18n.T(ctx, "me.idp_groups") }</dt>
				<dd class="sm:col-span-3">{ joinOrDash(page.IdPGroups) }</dd>
				<dt class="font-medium">{ i18n.T(ctx, "me.groups") }</dt>
				<dd class="sm:col-span-3">{ joinOrDash(page.Groups) }</dd>
				<dt class="font-medium">{ i18n.T(ctx, "me.webhooks") }</dt>
				<dd class="sm:col-span-3">{ joinOrDash(page.Webhooks) }</dd>
				<dt class="font-medium">{ i18n.T(ctx, "me.messages") }</dt>
				<dd class="sm:col-span-3">{ i18n.T(ctx, "me.messages."+messagesOrNone(page.Messages)) }</dd>
			</dl>
		}
		@grantedToMe(page.Granted, page.RoleGrants)
		@accessSection(i18n.T(ctx, "me.policies")) {
			if len(page.Policies) == 0 {
				@empty(i18n.T(ctx, "me.no_policies"))
			}
			<details>
				<summary class="cursor-pointer text-sm text-slate-600">{ i18n.T(ctx, "me.show_policies") }</summary>
				for _, p := range page.Policies {
					<pre class="mt-2 overflow-x-auto rounded bg-slate-50 p-2 text-xs"><code>{ p.Text }</code></pre>
				}
			</details>
		}
	}
}

// messagesOrNone names the empty message level.
func messagesOrNone(level string) string {
	if level == "" {
		return "none"
	}
	return level
}
