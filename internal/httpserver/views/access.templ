package views

import (
	"context"
	"slices"
	"strconv"
	"strings"

	"github.com/pflege-de-labs/teamster/internal/authz"
	"github.com/pflege-de-labs/teamster/internal/i18n"
	"github.com/pflege-de-labs/teamster/internal/models"
)

// Access is the admins' overview at /admin/access (ADR 0076).
type Access struct {
	Viewer Viewer
	// Admin is whether the viewer administers access; everyone else gets the
	// hub and the grants on records they may share, and nothing else here.
	Admin bool
	Hub   *Hub
	// Records name every record for the "Who can?" form.
	Records []HubClass
	// Principals are the choices of the level forms' pickers.
	Principals PrincipalOptions
	Webhooks   []WebhookAccess
	// Messages are the principals granted a message level (ADR 0082).
	Messages   []WebhookAccess
	Grants     []LabelledGrant
	Filter     string
	BaseText   string
	Generated  []authz.GeneratedPolicy
	Generation int64
	// The who tab: the question, and its answer when asked.
	WhoActions      []string
	RecordActions   []string
	ResourceActions map[string][]string
	WhoAction       string
	WhoResource     string
	WhoPrincipal    string
	Who             *WhoCan
	// Tab is the open check tab, who or what; May answers "What may ... do?" for MayPrincipal.
	Tab          string
	May          *WhatMay
	MayPrincipal string
	MayUnknown   bool
	MayMissing   bool
	Notice     string
	Error      string
}

// HubRecord is a record a grant may name, with where to edit it.
type HubRecord struct {
	ID       string
	Name     string
	Href     string
	CanShare bool
}

// HubClass is a resource type and its records.
type HubClass struct {
	Type    string
	Records []HubRecord
}

// Hub is the picker: a class, its records, and the grants of one record.
type Hub struct {
	Classes    []HubClass
	Class      string
	Records    []HubRecord
	SelectedID string
	Selected   *Sharing
	Principals PrincipalOptions
	// Principal is the "type:id" the picker starts on, from ?grant_to= on a group page's link.
	Principal string
	// Actions are what a batch may grant; ownership is passed on one record at a time.
	Actions []string
}

// WebhookAccess is one principal's webhook level.
type WebhookAccess struct {
	PrincipalType string
	PrincipalID   string
	Label         string
	Level         string
}

// LabelledGrant is a permission with names for its principal and resource.
type LabelledGrant struct {
	Permission models.Permission
	Principal  string
	Resource   string
	// Href is the record's edit page, empty for what has none.
	Href string
}

// WhoCan is everyone who may do something; WrongAction means nobody was asked.
type WhoCan struct {
	Allowed     []WhoRow
	WrongAction bool
}

// WhoRow is one user who may, and why.
type WhoRow struct {
	ID, Label string
	Via       []string
	Policies  []authz.ExplainedPolicy
}

// WebhookLevels are the choices the webhook form offers, weakest first.
var WebhookLevels = []string{"none", "alertmanager", "universal", "all", "admin"}

// MessageLevels are the choices the message form offers, weakest first.
var MessageLevels = []string{"none", "anyone", "everyone"}

templ AccessPage(page Access) {
	@Layout(i18n.T(ctx, "page.access"), &page.Viewer) {
		@notice(page.Error, page.Notice)
		<div class="space-y-6">
			@accessSection(i18n.T(ctx, "hub.heading")) {
				@hubPicker(page.Hub)
			}
			if page.Admin {
			@accessSection(i18n.T(ctx, "access.webhooks")) {
				<p class="text-sm text-slate-600">{ i18n.T(ctx, "access.webhooks_explainer") }</p>
				if len(page.Webhooks) > 0 {
					<ul class="divide-y divide-slate-200">
						for _, w := range page.Webhooks {
							<li class="flex items-center justify-between gap-3 py-2 text-sm">
								<span>
									<span class="mr-2 rounded bg-slate-100 px-1.5 py-0.5 text-xs text-slate-600">{ i18n.T(ctx, "sharing.principal."+w.PrincipalType) }</span>
									{ w.Label }
								</span>
								<span class="flex items-center gap-3">
									<span class="font-mono text-xs">{ i18n.T(ctx, "access.level."+w.Level) }</span>
									@levelRemove("/admin/access/webhooks", w)
								</span>
							</li>
						}
					</ul>
				}
				<form method="post" action="/admin/access/webhooks" class="grid gap-3 sm:grid-cols-4 sm:items-end">
					<div class="grid gap-2 sm:col-span-2">
						@principalPicker(PickerConfig{Name: "principal", Options: page.Principals})
					</div>
					<label class="block">
						<span class="text-sm font-medium">{ i18n.T(ctx, "access.level") }</span>
						<select name="level" class="mt-1 block w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm shadow-sm">
							for _, level := range WebhookLevels {
								<option value={ level }>{ i18n.T(ctx, "access.level."+level) }</option>
							}
						</select>
					</label>
					@submit(i18n.T(ctx, "sharing.grant"))
					<div class="sm:col-span-4">
						@notListed(PickerConfig{})
					</div>
				</form>
			}
			@accessSection(i18n.T(ctx, "access.messages")) {
				<p class="text-sm text-slate-600">{ i18n.T(ctx, "access.messages_explainer") }</p>
				if len(page.Messages) > 0 {
					<ul class="divide-y divide-slate-200">
						for _, m := range page.Messages {
							<li class="flex items-center justify-between gap-3 py-2 text-sm">
								<span>
									<span class="mr-2 rounded bg-slate-100 px-1.5 py-0.5 text-xs text-slate-600">{ i18n.T(ctx, "sharing.principal."+m.PrincipalType) }</span>
									{ m.Label }
								</span>
								<span class="flex items-center gap-3">
									<span class="font-mono text-xs">{ i18n.T(ctx, "access.message_level."+m.Level) }</span>
									@levelRemove("/admin/access/messages", m)
								</span>
							</li>
						}
					</ul>
				}
				<form method="post" action="/admin/access/messages" class="grid gap-3 sm:grid-cols-4 sm:items-end">
					<div class="grid gap-2 sm:col-span-2">
						@principalPicker(PickerConfig{Name: "principal", Options: page.Principals})
					</div>
					<label class="block">
						<span class="text-sm font-medium">{ i18n.T(ctx, "access.level") }</span>
						<select name="level" class="mt-1 block w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm shadow-sm">
							for _, level := range MessageLevels {
								<option value={ level }>{ i18n.T(ctx, "access.message_level."+level) }</option>
							}
						</select>
					</label>
					@submit(i18n.T(ctx, "sharing.grant"))
					<div class="sm:col-span-4">
						@notListed(PickerConfig{})
					</div>
				</form>
			}
			<section class="rounded-lg border border-slate-200 bg-white shadow-sm">
				<nav role="tablist" aria-label={ i18n.T(ctx, "access.check") } class="flex gap-1 border-b border-slate-200 px-4" data-admin-tabs>
					for _, name := range []string{"who", "what"} {
						<a
							href={ templ.SafeURL("/admin/access?tab=" + name) }
							role="tab"
							id={ "tab-" + name }
							aria-controls={ "panel-" + name }
							aria-selected={ strconv.FormatBool(name == page.Tab) }
							data-tab={ name }
							class="-mb-px border-b-2 border-transparent px-3 py-3 text-sm font-medium text-slate-600 hover:text-sky-700 aria-selected:border-sky-600 aria-selected:text-slate-900"
						>
							{ i18n.T(ctx, "access.check_"+name) }
						</a>
					}
				</nav>
				<div id="panel-what" role="tabpanel" aria-labelledby="tab-what" data-tab-panel="what" hidden?={ page.Tab != "what" } class="space-y-4 px-6 py-6">
					<form method="get" action="/admin/access" class="grid gap-3 sm:grid-cols-4 sm:items-end">
						<input type="hidden" name="tab" value="what"/>
						<div class="grid gap-2 sm:col-span-3">
							@principalPicker(PickerConfig{Name: "principal", Label: "sharing.principal", Options: page.Principals, Selected: page.MayPrincipal})
						</div>
						@submit(i18n.T(ctx, "access.show"))
						<div class="sm:col-span-4">
							@notListed(PickerConfig{})
						</div>
					</form>
					if page.MayUnknown {
						<p class="text-sm text-amber-800">{ i18n.T(ctx, "access.unknown_user") }</p>
					}
					if page.MayMissing {
						<p class="text-sm text-amber-800">{ i18n.T(ctx, "access.unknown_principal") }</p>
					}
					if page.May != nil {
						@mayList(*page.May, MayListOptions{Principal: page.MayPrincipal, Levels: true})
						for _, role := range page.May.Roles {
							<p class="text-sm">
								<span class="font-medium">{ role.Role }</span>:
								{ i18n.T(ctx, "me.role_summary", actionLabels(ctx, role.Actions), i18n.T(ctx, "hub.class."+role.Type)) }
							</p>
						}
					}
				</div>
				<div id="panel-who" role="tabpanel" aria-labelledby="tab-who" data-tab-panel="who" hidden?={ page.Tab != "who" } class="space-y-4 px-6 py-6">
					<form method="get" action="/admin/access" class="grid gap-3 sm:grid-cols-4 sm:items-end" data-access-check>
						<input type="hidden" name="tab" value="who"/>
						<label class="block">
							<span class="text-sm font-medium">{ i18n.T(ctx, "audit.action") }</span>
							<select name="action" class="mt-1 block w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm shadow-sm">
								for _, a := range page.WhoActions {
									<option value={ a } selected?={ a == page.WhoAction }>{ i18n.T(ctx, "sharing.action."+a) }</option>
								}
							</select>
						</label>
						<label class="block">
							<span class="text-sm font-medium">{ i18n.T(ctx, "access.resource") }</span>
							<select name="resource" class="mt-1 block w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm shadow-sm">
								for _, class := range page.Records {
									<optgroup label={ i18n.T(ctx, "hub.class."+class.Type) }>
										for _, rec := range class.Records {
											<option value={ class.Type + ":" + rec.ID } data-actions={ strings.Join(resourceActionsOf(page, class.Type), " ") } selected?={ class.Type+":"+rec.ID == page.WhoResource }>{ rec.Name }</option>
										}
									</optgroup>
								}
							</select>
						</label>
						<div class="grid gap-2">
							@principalPicker(PickerConfig{Name: "principal", Label: "access.narrow", Options: page.Principals, Selected: page.WhoPrincipal})
						</div>
						@submit(i18n.T(ctx, "access.ask"))
					</form>
					if page.Who != nil {
						<div data-who-answer class="space-y-4">
							@whoAnswer(*page.Who, actionName(ctx, page.WhoActions, page.WhoAction))
						</div>
					}
				</div>
			</section>
			}
			@accessSection(i18n.T(ctx, grantsHeading(page.Admin))) {
				<form method="get" action="/admin/access" class="flex max-w-xl items-end gap-2">
					<div class="grow">
						@textField("filter", i18n.T(ctx, "access.filter"), "Template", page.Filter)
					</div>
					@submit(i18n.T(ctx, "audit.filter"))
				</form>
				if len(page.Grants) == 0 {
					@empty(i18n.T(ctx, "access.no_grants"))
				} else {
					<table class="w-full text-left text-sm">
						<thead class="text-xs text-slate-500">
							<tr>
								<th class="py-1">{ i18n.T(ctx, "sharing.principal") }</th>
								<th class="py-1">{ i18n.T(ctx, "access.resource") }</th>
								<th class="py-1">{ i18n.T(ctx, "sharing.actions") }</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-slate-100">
							for _, g := range page.Grants {
								<tr>
									<td class="py-1">{ g.Principal }</td>
									<td class="py-1">
										if g.Href != "" {
											<a href={ templ.SafeURL(g.Href) } class="text-sky-700 hover:underline">{ g.Resource }</a>
										} else {
											{ g.Resource }
										}
									</td>
									<td class="py-1 font-mono text-xs">{ joinOrDash(g.Permission.Actions) }</td>
								</tr>
							}
						</tbody>
					</table>
				}
			}
			if page.Admin {
			@accessSection(i18n.T(ctx, "access.policies")) {
				<p class="text-xs text-slate-500">{ i18n.T(ctx, "access.generation", page.Generation) }</p>
				<details>
					<summary class="cursor-pointer text-sm font-medium">{ i18n.T(ctx, "access.base") }</summary>
					<pre class="mt-2 overflow-x-auto rounded bg-slate-50 p-3 text-xs"><code>{ page.BaseText }</code></pre>
				</details>
				for _, p := range page.Generated {
					<pre class="overflow-x-auto rounded bg-slate-50 p-2 text-xs"><code>{ p.Text }</code></pre>
				}
			}
			}
		</div>
	}
}

// levelRemove clears a principal's level; without it a row could only be removed by retyping its id.
templ levelRemove(action string, row WebhookAccess) {
	<form method="post" action={ templ.SafeURL(action) }>
		<input type="hidden" name="principal_type" value={ row.PrincipalType }/>
		<input type="hidden" name="principal_id" value={ row.PrincipalID }/>
		<input type="hidden" name="level" value="none"/>
		<button type="submit" class="rounded-md border border-slate-300 px-3 py-1 text-xs text-slate-700 hover:border-red-400 hover:bg-red-50 hover:text-red-700">{ i18n.T(ctx, "sharing.revoke") }</button>
	</form>
}

templ accessSection(title string) {
	<section class="rounded-lg border border-slate-200 bg-white shadow-sm">
		<h2 class="border-b border-slate-200 px-6 py-4 text-lg font-semibold">{ title }</h2>
		<div class="space-y-4 px-6 py-6">
			{ children... }
		</div>
	</section>
}

// grantsHeading names the grants table; a non-admin's lists only records they may share.
func grantsHeading(admin bool) string {
	if admin {
		return "access.grants"
	}
	return "access.grants_mine"
}

// resourceActionsOf is what the form may ask about a class of records.
func resourceActionsOf(page Access, typ string) []string {
	if a, ok := page.ResourceActions[typ]; ok {
		return a
	}
	return page.RecordActions
}

templ whoAnswer(who WhoCan, action string) {
	if who.WrongAction {
		<p class="text-sm text-amber-800">{ i18n.T(ctx, "access.wrong_action", action) }</p>
	} else {
		if len(who.Allowed) == 0 {
			<p class="text-sm font-medium text-red-700">{ i18n.T(ctx, "access.nobody") }</p>
		} else {
			<p class="text-sm font-medium text-emerald-700">{ i18n.T(ctx, "access.allowed_count", len(who.Allowed)) }</p>
			<ul class="divide-y divide-slate-100 text-sm">
				for _, row := range who.Allowed {
					<li class="py-2">
						<span class="font-medium">{ row.Label }</span>
						<span class="font-mono text-xs text-slate-500">{ row.ID }</span>
						<span class="text-slate-600">{ strings.Join(row.Via, ", ") }</span>
						<details>
							<summary class="cursor-pointer text-xs text-slate-500">{ i18n.T(ctx, "access.policies_short") }</summary>
							for _, p := range row.Policies {
								<pre class="mt-1 overflow-x-auto rounded bg-slate-50 p-2 text-xs"><code>{ p.Text }</code></pre>
							}
						</details>
					</li>
				}
			</ul>
		}
		<p class="text-xs text-slate-500">{ i18n.T(ctx, "access.not_signed_in") }</p>
	}
}

// actionName is a known action's label, and anything else as it was typed.
func actionName(ctx context.Context, known []string, action string) string {
	if slices.Contains(known, action) {
		return i18n.T(ctx, "sharing.action."+action)
	}
	return action
}

// MyAccess is /admin/me: what the signed-in person may do, and why.
type MyAccess struct {
	Viewer    Viewer
	Subject   string
	Roles     []string
	IdPGroups []string
	Groups    []string
	Webhooks  []string
	// Messages is how far they may address people (ADR 0082).
	Messages  string
	Policies  []authz.GeneratedPolicy
	// Granted is what was shared with the viewer; Roles what their roles allow on whole collections.
	Granted    []MyGrant
	RoleGrants []RoleSummary
	Error   string
}

// MyGrant is a record the viewer holds actions on, and through whom.
type MyGrant struct {
	Type    string
	Name    string
	Href    string
	Actions []string
	Via     []string
}

// WhatMay is what a principal may do, as the authorizer decides it.
type WhatMay struct {
	Records  []MayRow
	Roles    []RoleSummary
	Webhooks string
	Messages string
	// WebhooksVia and MessagesVia are the reasons for the two levels.
	WebhooksVia, MessagesVia []string
}

// MayRow is one record a principal may act on, with the reasons it may.
type MayRow struct {
	Type, ID, Name, Href string
	Actions              []string
	Via                  []string
	Direct               *models.Permission
	CanShare             bool
	CanTransfer          bool
}

// RoleSummary is what one role allows on every record of a type.
type RoleSummary struct {
	Role    string
	Type    string
	Actions []string
}

templ MyAccessPage(page MyAccess) {
	@Layout(i18n.T(ctx, "page.me"), &page.Viewer) {
		@notice(page.Error, "")
		@accessSection(i18n.T(ctx, "me.heading")) {
			<dl class="grid gap-2 text-sm sm:grid-cols-4">
				<dt class="font-medium">{ i18n.T(ctx, "access.subject") }</dt>
				<dd class="font-mono text-xs sm:col-span-3">{ page.Subject }</dd>
				<dt class="font-medium">{ i18n.T(ctx, "me.roles") }</dt>
				<dd class="sm:col-span-3">{ joinOrDash(page.Roles) }</dd>
				<dt class="font-medium">{ i18n.T(ctx, "me.idp_groups") }</dt>
				<dd class="sm:col-span-3">{ joinOrDash(page.IdPGroups) }</dd>
				<dt class="font-medium">{ i18n.T(ctx, "me.groups") }</dt>
				<dd class="sm:col-span-3">{ joinOrDash(page.Groups) }</dd>
				<dt class="font-medium">{ i18n.T(ctx, "me.webhooks") }</dt>
				<dd class="sm:col-span-3">{ joinOrDash(page.Webhooks) }</dd>
				<dt class="font-medium">{ i18n.T(ctx, "me.messages") }</dt>
				<dd class="sm:col-span-3">{ i18n.T(ctx, "me.messages."+messagesOrNone(page.Messages)) }</dd>
			</dl>
		}
		@grantedToMe(page.Granted, page.RoleGrants)
		@accessSection(i18n.T(ctx, "me.policies")) {
			if len(page.Policies) == 0 {
				@empty(i18n.T(ctx, "me.no_policies"))
			}
			<details>
				<summary class="cursor-pointer text-sm text-slate-600">{ i18n.T(ctx, "me.show_policies") }</summary>
				for _, p := range page.Policies {
					<pre class="mt-2 overflow-x-auto rounded bg-slate-50 p-2 text-xs"><code>{ p.Text }</code></pre>
				}
			</details>
		}
	}
}

// messagesOrNone names the empty message level.
func messagesOrNone(level string) string {
	if level == "" {
		return "none"
	}
	return level
}
