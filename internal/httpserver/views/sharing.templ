package views

import (
	"slices"
	"strings"

	"github.com/pflege-de-labs/teamster/internal/i18n"
	"github.com/pflege-de-labs/teamster/internal/models"
)

// PrincipalOptions are whom a grant may name: the users, groups and provider
// groups known here, and the roles a deployment defines.
type PrincipalOptions struct {
	Users     []models.User
	Groups    []models.Group
	IdPGroups []string
	Roles     []string
	// MoreUsers says Users is the first page only; the picker searches the rest.
	MoreUsers bool
}

// Sharing is who may do what with one record, and the form to change it (ADR 0075).
type Sharing struct {
	ResourceType string
	ResourceID   string
	// Return is where the forms land afterwards.
	Return      string
	Permissions []SharedPermission
	CanShare    bool
	CanTransfer bool
	// Actions are what may be granted on this record, own last.
	Actions    []string
	Principals PrincipalOptions
}

// SharedPermission is a row and the name of whom it names.
type SharedPermission struct {
	Permission models.Permission
	Label      string
}

// Owned reports whether any row makes an owner; without one the admins own it.
func (s Sharing) Owned() bool {
	for _, p := range s.Permissions {
		if slices.Contains(p.Permission.Actions, "own") {
			return true
		}
	}
	return false
}

templ sharingPanel(s Sharing) {
	<section class="space-y-3 rounded-md border border-slate-200 p-4" id="sharing">
		<h3 class="text-sm font-semibold">{ i18n.T(ctx, "sharing.heading."+s.ResourceType) }</h3>
		if !s.Owned() {
			<p class="text-xs text-slate-500">{ i18n.T(ctx, "sharing.unowned") }</p>
		}
		if len(s.Permissions) > 0 {
			<ul class="divide-y divide-slate-200">
				for _, p := range s.Permissions {
					<li class="py-2 text-sm">
						@sharedRow(s, p)
					</li>
				}
			</ul>
			<p class="text-xs text-slate-500">{ i18n.T(ctx, "sharing.legend") }</p>
		}
		if s.CanShare {
			<details class="text-sm">
				<summary class="cursor-pointer font-medium">{ i18n.T(ctx, "sharing.add") }</summary>
				<form method="post" action="/admin/sharing/grant" class="mt-3 space-y-3">
					<input type="hidden" name="resource_type" value={ s.ResourceType }/>
					<input type="hidden" name="resource_id" value={ s.ResourceID }/>
					<input type="hidden" name="return" value={ s.Return }/>
					@principalPicker(PickerConfig{Name: "principal", Options: s.Principals, AllowOther: true})
					@actionBoxes(s.Actions, s.CanTransfer, nil)
					<p class="text-xs text-slate-500">{ i18n.T(ctx, "sharing.replace_hint") }</p>
					@submit(i18n.T(ctx, "sharing.grant"))
				</form>
			</details>
		}
	</section>
}

// sharedRow is one grant, editable in place: its boxes are what the principal
// holds now, and saving replaces them.
templ sharedRow(s Sharing, p SharedPermission) {
	{{ mayChange := s.CanShare && (s.CanTransfer || !slices.Contains(p.Permission.Actions, "own")) }}
	<div class="flex flex-wrap items-center gap-3">
		<span class="rounded bg-slate-100 px-1.5 py-0.5 text-xs text-slate-600">{ i18n.T(ctx, "sharing.principal." + string(p.Permission.PrincipalType)) }</span>
		<span class="min-w-0 flex-1 font-medium">{ p.Label }</span>
		<code class="font-mono text-xs text-slate-500" title={ actionLabels(ctx, p.Permission.Actions) }>{ actionRef(ctx, p.Permission.Actions) }</code>
		if mayChange {
			<details class="w-full text-sm sm:w-auto">
				<summary class="cursor-pointer text-xs text-slate-600">{ i18n.T(ctx, "sharing.edit") }</summary>
				<div class="mt-2 flex flex-wrap items-center gap-3">
					<form method="post" action="/admin/sharing/grant" class="flex flex-wrap items-center gap-3">
						<input type="hidden" name="resource_type" value={ s.ResourceType }/>
						<input type="hidden" name="resource_id" value={ s.ResourceID }/>
						<input type="hidden" name="return" value={ s.Return }/>
						<input type="hidden" name="principal" value={ string(p.Permission.PrincipalType) + ":" + p.Permission.PrincipalID }/>
						@actionBoxes(s.Actions, s.CanTransfer, p.Permission.Actions)
						<button type="submit" class="rounded-md border border-slate-300 px-3 py-1 text-xs text-slate-700 hover:bg-slate-50">{ i18n.T(ctx, "sharing.grant") }</button>
					</form>
					<form method="post" action="/admin/sharing/revoke" class="shrink-0">
						<input type="hidden" name="id" value={ p.Permission.ID }/>
						<input type="hidden" name="return" value={ s.Return }/>
						<button type="submit" class="rounded-md border border-slate-300 px-3 py-1 text-xs text-slate-700 hover:border-red-400 hover:bg-red-50 hover:text-red-700">
							{ i18n.T(ctx, "sharing.revoke") }
						</button>
					</form>
				</div>
			</details>
		}
	</div>
}

// PickerConfig is one principal picker. Kinds limits the groups offered, in the
// order user, group, idp_group, role; empty offers all. Label is an i18n key.
type PickerConfig struct {
	Name       string
	Label      string
	Options    PrincipalOptions
	Kinds      []string
	Selected   string
	AllowOther bool
	Required   bool
}

func (p PickerConfig) label() string {
	if p.Label == "" {
		return "sharing.principal_type"
	}
	return p.Label
}

// searchURL is where the picker looks for users its page did not list; empty
// when it listed them all.
func (p PickerConfig) searchURL() string {
	if p.Options.MoreUsers && p.offers("user") {
		return "/admin/principals"
	}
	return ""
}

func (p PickerConfig) offers(kind string) bool {
	return len(p.Kinds) == 0 || slices.Contains(p.Kinds, kind)
}

// otherKinds are the kinds the "not listed" block may name; a local group has
// to exist already, so it is never typed in.
func (p PickerConfig) otherKinds() []string {
	var kinds []string
	for _, k := range []string{"user", "idp_group", "role"} {
		if p.offers(k) {
			kinds = append(kinds, k)
		}
	}
	return kinds
}

// principalPicker names a principal from the ones known here. A person who has
// not signed in yet is not known, so AllowOther adds fields that take them by name.
templ principalPicker(p PickerConfig) {
	<label class="block">
		<span class="text-sm font-medium">{ i18n.T(ctx, p.label()) }</span>
		<select name={ p.Name } data-principal-picker data-search-url={ p.searchURL() } required?={ p.Required } class="mt-1 block w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm shadow-sm">
			<option value="">{ i18n.T(ctx, "sharing.choose") }</option>
			if p.offers("user") && len(p.Options.Users) > 0 {
				<optgroup label={ i18n.T(ctx, "sharing.principal.user") }>
					for _, u := range p.Options.Users {
						<option value={ "user:" + u.Subject } data-search={ strings.TrimSpace(displayName(u) + " " + u.Email + " " + u.Subject) } title={ u.Subject } selected?={ p.Selected == "user:"+u.Subject }>{ displayName(u) }</option>
					}
				</optgroup>
			}
			if p.offers("group") && len(p.Options.Groups) > 0 {
				<optgroup label={ i18n.T(ctx, "sharing.principal.group") }>
					for _, g := range p.Options.Groups {
						<option value={ "group:" + g.ID } data-search={ g.Name + " " + g.ID } title={ g.ID } selected?={ p.Selected == "group:"+g.ID }>{ g.Name }</option>
					}
				</optgroup>
			}
			if p.offers("idp_group") && len(p.Options.IdPGroups) > 0 {
				<optgroup label={ i18n.T(ctx, "sharing.principal.idp_group") }>
					for _, name := range p.Options.IdPGroups {
						<option value={ "idp_group:" + name } data-search={ name } title={ name } selected?={ p.Selected == "idp_group:"+name }>{ name }</option>
					}
				</optgroup>
			}
			if p.offers("role") && len(p.Options.Roles) > 0 {
				<optgroup label={ i18n.T(ctx, "sharing.principal.role") }>
					for _, role := range p.Options.Roles {
						<option value={ "role:" + role } data-search={ role } title={ role } selected?={ p.Selected == "role:"+role }>{ role }</option>
					}
				</optgroup>
			}
		</select>
	</label>
	if p.AllowOther {
		@notListed(p)
	}
}

// notListed takes a principal by name; a form laid out in one row renders it
// as a row of its own so the controls beside the picker stay level with it.
templ notListed(p PickerConfig) {
	if len(p.otherKinds()) > 0 {
		<details class="text-sm">
			<summary class="cursor-pointer text-slate-600">{ i18n.T(ctx, "sharing.not_listed") }</summary>
			<div class="mt-2 grid gap-3 sm:grid-cols-2">
				<select name="other_type" class="block w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm shadow-sm">
					for _, t := range p.otherKinds() {
						<option value={ t }>{ i18n.T(ctx, "sharing.principal."+t) }</option>
					}
				</select>
				<input name="other_id" class="block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm"/>
			</div>
			<p class="mt-1 text-xs text-slate-500">{ i18n.T(ctx, "sharing.not_listed_hint") }</p>
		</details>
	}
}

// actionBoxes are the actions to grant, with those already held ticked.
templ actionBoxes(actions []string, canTransfer bool, held []string) {
	<fieldset class="flex flex-wrap gap-4">
		<legend class="text-sm font-medium">{ i18n.T(ctx, "sharing.actions") }</legend>
		for _, action := range actions {
			if action != "own" || canTransfer {
				<label class="flex items-center gap-2 text-sm">
					<input type="checkbox" name="actions" value={ action } checked?={ slices.Contains(held, action) } class="h-4 w-4 rounded border-slate-300"/>
					{ i18n.T(ctx, "sharing.action."+action) }
				</label>
			}
		}
	</fieldset>
}
